&control
  calculation = 'scf'
  prefix = 'ic_si_bulk_2atom_scf_v0'
  pseudo_dir = '/usr/share/espresso/pseudo'
  outdir = 'artifacts/qe_ic_7day_prelim/qe_tmp/ic_si_bulk_2atom_scf_v0'
  verbosity = 'low'
/
&system
  ibrav = 2
  celldm(1) = 10.26
  nat = 2
  ntyp = 1
  ecutwfc = 12.0
/
&electrons
  conv_thr = 1.0d-6
  mixing_beta = 0.5
  electron_maxstep = 30
/
ATOMIC_SPECIES
  Si 28.0855 Si.pz-vbc.UPF
ATOMIC_POSITIONS crystal
  Si 0.000000 0.000000 0.000000
  Si 0.250000 0.250000 0.250000
K_POINTS automatic
  2 2 2 0 0 0
