{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchitectureSpec",
  "description": "Step 2 output / Step 3 input - Selected architecture with frozen interfaces",
  "version": "1.0.0",
  
  "type": "object",
  "required": ["schema_version", "spec_id", "workload_profile_ref", "partition", "interfaces", "selected_family", "frozen_at", "provenance"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "architecture_spec_v1",
      "description": "Schema version"
    },
    
    "spec_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique architecture spec identifier"
    },
    
    "workload_profile_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of input WorkloadProfile"
    },
    
    "partition": {
      "type": "object",
      "required": ["host_scope", "device_scope", "fallback_scope"],
      "properties": {
        "host_scope": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Kernels/stages kept on host"
        },
        "device_scope": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Kernels/stages offloaded to device"
        },
        "fallback_scope": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Kernels/stages with device→host fallback"
        }
      }
    },
    
    "interfaces": {
      "type": "object",
      "required": ["host_to_runtime", "runtime_to_chip", "completion_handshake"],
      "properties": {
        "host_to_runtime": {
          "type": "object",
          "required": ["protocol"],
          "properties": {
            "protocol": {"type": "string", "enum": ["PCIe", "CXL", "NVLink", "Ethernet", "Custom"]},
            "bandwidth_gbps": {"type": "number", "minimum": 0},
            "latency_us": {"type": "number", "minimum": 0}
          }
        },
        "runtime_to_chip": {
          "type": "object",
          "required": ["protocol"],
          "properties": {
            "protocol": {"type": "string", "enum": ["AXI", "CHI", "TileLink", "Custom"]},
            "bandwidth_gbps": {"type": "number", "minimum": 0},
            "latency_ns": {"type": "number", "minimum": 0}
          }
        },
        "completion_handshake": {
          "type": "object",
          "required": ["protocol"],
          "properties": {
            "protocol": {"type": "string", "enum": ["Polling", "Interrupt", "Mailbox", "Custom"]},
            "notification_latency_us": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    
    "selected_family": {
      "type": "string",
      "enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "custom"],
      "description": "Selected architecture family"
    },
    
    "family_rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Evidence-based rationale for family selection"
    },
    
    "architecture_variants_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant_id": {"type": "string"},
          "name": {"type": "string"},
          "score": {"type": "number"},
          "is_pareto": {"type": "boolean"}
        }
      },
      "description": "List of variants evaluated with scores"
    },
    
    "frozen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when architecture was frozen"
    },
    
    "provenance": {
      "type": "object",
      "required": ["input_hash", "generated_at", "tool_version"],
      "properties": {
        "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "tool_version": {"type": "string"}
      }
    }
  },
  
  "allOf": [
    {
      "description": "Scopes must partition workload (no overlap, no omission)",
      "if": {"required": ["partition"]},
      "then": {
        "properties": {
          "partition": {
            "properties": {
              "host_scope": {"type": "array"},
              "device_scope": {"type": "array"},
              "fallback_scope": {"type": "array"}
            }
          }
        }
      }
    }
  ]
}
