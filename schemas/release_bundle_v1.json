{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseBundle",
  "description": "Step 6 output - Final release package with recommendations",
  "version": "1.0.0",
  
  "type": "object",
  "required": ["schema_version", "bundle_id", "evaluation_results", "pareto_frontier", "recommendation", "authority", "provenance"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "release_bundle_v1"
    },
    
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    
    "evaluation_results": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "description": "Hashes of all EvaluationResult artifacts"
    },
    
    "pareto_frontier": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "description": "Hashes of Pareto-optimal EvaluationResult artifacts"
    },
    
    "recommendation": {
      "type": "object",
      "required": ["primary_design_point", "rationale", "confidence"],
      "properties": {
        "primary_design_point": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fallback_design_points": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "rationale": {"type": "string", "minLength": 20},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {"type": "string"},
              "value": {"type": "number"},
              "sacrifice": {"type": "string"}
            }
          }
        }
      }
    },
    
    "authority": {
      "type": "object",
      "required": ["stage", "claim_posture"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["A", "B"],
          "description": "Stage A (evidence) or Stage B (thesis-grade)"
        },
        "claim_posture": {
          "type": "string",
          "enum": ["evidence_only", "projection_grade", "thesis_grade"]
        },
        "adjudicator_approval": {"type": "boolean"},
        "approval_date": {"type": "string", "format": "date-time"},
        "adjudicator_id": {"type": "string"},
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    
    "quality_gates": {
      "type": "object",
      "properties": {
        "correctness_validated": {"type": "boolean"},
        "gpu_baseline_compared": {"type": "boolean"},
        "workload_coverage_verified": {"type": "boolean"},
        "generalization_tested": {"type": "boolean"},
        "power_constraints_met": {"type": "boolean"}
      }
    },
    
    "provenance": {
      "type": "object",
      "required": ["input_hash", "generated_at", "tool_version"],
      "properties": {
        "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "tool_version": {"type": "string"},
        "pipeline_duration_seconds": {"type": "number", "minimum": 0}
      }
    }
  },
  
  "allOf": [
    {
      "description": "Pareto frontier must be non-empty subset of evaluation_results",
      "if": {"required": ["pareto_frontier", "evaluation_results"]},
      "then": {
        "properties": {
          "pareto_frontier": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "description": "Stage B requires adjudicator approval",
      "if": {
        "properties": {
          "authority": {
            "properties": {
              "stage": {"const": "B"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "adjudicator_approval": {"const": true}
            }
          }
        }
      }
    }
  ]
}
