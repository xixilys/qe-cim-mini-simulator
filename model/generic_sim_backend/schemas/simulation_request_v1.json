{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dse-framework.org/schemas/simulation_request_v1.json",
  "title": "Generic Simulation Request",
  "description": "Request schema for generic SystemC/gem5 simulation backend",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "workload", "architecture"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "gsim.request.v1",
      "description": "Schema version identifier"
    },
    "run_id": {
      "type": "string",
      "description": "Unique run identifier"
    },
    "mode": {
      "type": "string",
      "enum": ["standalone_systemc", "gem5_cosim", "gem5_systemc_blocked", "analytical"],
      "description": "Simulation execution mode"
    },
    "workload": {
      "type": "object",
      "required": ["graph_id", "nodes"],
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["op_type", "estimated_flops", "estimated_memory_bytes"],
            "properties": {
              "op_type": {
                "type": "string",
                "enum": ["gemm", "fft", "eigen", "reduction", "elementwise", "transfer", "generic_op"]
              },
              "inputs": {
                "type": "array",
                "items": {"type": "string"}
              },
              "outputs": {
                "type": "array",
                "items": {"type": "string"}
              },
              "estimated_flops": {
                "type": "number",
                "minimum": 0
              },
              "estimated_memory_bytes": {
                "type": "number",
                "minimum": 0
              },
              "attributes": {
                "type": "object",
                "description": "Operation-specific parameters"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "tensor_name"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "tensor_name": {"type": "string"},
              "tensor_shape": {
                "type": "array",
                "items": {"type": "integer"}
              },
              "tensor_dtype": {
                "type": "string",
                "enum": ["FP64", "FP32", "FP16", "INT8"]
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["host", "accelerators"],
      "properties": {
        "host": {
          "type": "object",
          "required": ["cpu_model", "clock_mhz"],
          "properties": {
            "cpu_model": {"type": "string"},
            "clock_mhz": {"type": "number"},
            "memory_bw_gbps": {"type": "number"},
            "cores": {"type": "integer"}
          }
        },
        "interconnect": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["pcie", "nvlink", "cxl", "custom"]},
            "bandwidth_gbps": {"type": "number"},
            "latency_ns": {"type": "number"}
          }
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["accel_id", "accel_type", "clock_mhz"],
            "properties": {
              "accel_id": {"type": "string"},
              "accel_type": {
                "type": "string",
                "enum": ["gpu", "fpga", "cim", "asic", "cpu"]
              },
              "clock_mhz": {"type": "number"},
              "local_memory_kb": {"type": "number"},
              "power": {
                "type": "object",
                "properties": {
                  "static_w": {"type": "number"},
                  "max_w": {"type": "number"}
                }
              },
              "capabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "peak_gops": {"type": "number"},
                    "efficiency": {"type": "number"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "node_id -> accel_id mapping"
    },
    "scheduling": {
      "type": "object",
      "properties": {
        "policy": {"type": "string", "enum": ["static", "dynamic", "pipeline"]},
        "allow_overlap_dma_compute": {"type": "boolean"},
        "double_buffer": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "result_json": {"type": "string"},
        "trace_json": {"type": "string"}
      }
    }
  }
}
