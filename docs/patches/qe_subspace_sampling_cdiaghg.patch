+!----------------------------------------------------------------------------
+SUBROUTINE qe_subspace_trace_complex( solver, n, m, h, s, ldh, all_eigenvalues )
+  !----------------------------------------------------------------------------
+  USE laxlib_parallel_include
+  IMPLICIT NONE
+  include 'laxlib_kinds.fh'
+  CHARACTER(LEN=*), INTENT(IN) :: solver
+  INTEGER, INTENT(IN) :: n, m, ldh
+  LOGICAL, INTENT(IN) :: all_eigenvalues
+  COMPLEX(DP), INTENT(IN) :: h(ldh,*), s(ldh,*)
+  LOGICAL, SAVE :: cfg_init = .FALSE.
+  LOGICAL, SAVE :: trace_enabled = .FALSE.
+  LOGICAL, SAVE :: dump_enabled = .FALSE.
+  INTEGER, SAVE :: dump_limit = 0
+  INTEGER, SAVE :: min_n = 0
+  INTEGER, SAVE :: call_id = 0
+  CHARACTER(LEN=512), SAVE :: trace_file = ''
+  CHARACTER(LEN=512), SAVE :: dump_dir = ''
+  LOGICAL :: file_exists
+  INTEGER :: unit_id, ios
+  REAL(DP) :: h_frob, h_max_abs, h_min_nz_abs
+  REAL(DP) :: h_diag_min, h_diag_max, h_diag_imag_max, h_herm_rel
+  REAL(DP) :: s_frob, s_max_abs, s_min_nz_abs
+  REAL(DP) :: s_diag_min, s_diag_max, s_diag_imag_max, s_herm_rel
+  REAL(DP) :: s_identity_rel
+
+  IF ( .NOT. cfg_init ) THEN
+     CALL qe_subspace_trace_init_complex( trace_enabled, dump_enabled, &
+                                          dump_limit, min_n, trace_file, dump_dir )
+     cfg_init = .TRUE.
+  END IF
+
+  IF ( .NOT. trace_enabled .AND. .NOT. dump_enabled ) RETURN
+  IF ( n < min_n ) RETURN
+
+  call_id = call_id + 1
+
+  CALL qe_complex_matrix_stats( n, h, ldh, .FALSE., h_frob, h_max_abs, h_min_nz_abs, &
+                                h_diag_min, h_diag_max, h_diag_imag_max, h_herm_rel )
+  CALL qe_complex_matrix_stats( n, s, ldh, .TRUE., s_frob, s_max_abs, s_min_nz_abs, &
+                                s_diag_min, s_diag_max, s_diag_imag_max, s_herm_rel, s_identity_rel )
+
+  IF ( trace_enabled ) THEN
+     INQUIRE( FILE=TRIM(trace_file), EXIST=file_exists )
+     OPEN( NEWUNIT=unit_id, FILE=TRIM(trace_file), STATUS='UNKNOWN', POSITION='APPEND', &
+           ACTION='WRITE', IOSTAT=ios )
+     IF ( ios == 0 ) THEN
+        IF ( .NOT. file_exists ) THEN
+           WRITE( unit_id, '(A)' ) &
+              'call_id,solver,n,m,all_eigenvalues,h_frob,h_max_abs,h_min_nz_abs,' // &
+              'h_diag_min,h_diag_max,h_diag_imag_max,h_herm_rel,' // &
+              's_frob,s_max_abs,s_min_nz_abs,s_diag_min,s_diag_max,' // &
+              's_diag_imag_max,s_herm_rel,s_identity_rel'
+        END IF
+        WRITE( unit_id, &
+               '(I0,",",A,",",I0,",",I0,",",L1,15(",",ES24.16E3))' ) &
+             call_id, TRIM(solver), n, m, all_eigenvalues, &
+             h_frob, h_max_abs, h_min_nz_abs, h_diag_min, h_diag_max, h_diag_imag_max, h_herm_rel, &
+             s_frob, s_max_abs, s_min_nz_abs, s_diag_min, s_diag_max, s_diag_imag_max, &
+             s_herm_rel, s_identity_rel
+        CLOSE( unit_id )
+     END IF
+  END IF
+
+  IF ( dump_enabled .AND. call_id <= dump_limit ) THEN
+     CALL qe_dump_complex_matrix( dump_dir, solver, 'H', call_id, n, m, h, ldh )
+     CALL qe_dump_complex_matrix( dump_dir, solver, 'S', call_id, n, m, s, ldh )
+  END IF
+
+END SUBROUTINE qe_subspace_trace_complex
+
+!----------------------------------------------------------------------------
+SUBROUTINE qe_subspace_trace_init_complex( trace_enabled, dump_enabled, dump_limit, &
+                                           min_n, trace_file, dump_dir )
+  !----------------------------------------------------------------------------
+  IMPLICIT NONE
+  LOGICAL, INTENT(OUT) :: trace_enabled, dump_enabled
+  INTEGER, INTENT(OUT) :: dump_limit, min_n
+  CHARACTER(LEN=512), INTENT(OUT) :: trace_file, dump_dir
+  CHARACTER(LEN=512) :: env
+  INTEGER :: env_len, env_status, ios
+
+  trace_enabled = .FALSE.
+  dump_enabled = .FALSE.
+  dump_limit = 0
+  min_n = 0
+  trace_file = ''
+  dump_dir = ''
+
+  CALL GET_ENVIRONMENT_VARIABLE( 'QE_SUBSPACE_TRACE_FILE', env, LENGTH=env_len, STATUS=env_status )
+  IF ( env_status == 0 .AND. env_len > 0 ) THEN
+     trace_file = env(1:env_len)
+     trace_enabled = .TRUE.
+  END IF
+
+  CALL GET_ENVIRONMENT_VARIABLE( 'QE_SUBSPACE_DUMP_DIR', env, LENGTH=env_len, STATUS=env_status )
+  IF ( env_status == 0 .AND. env_len > 0 ) THEN
+     dump_dir = env(1:env_len)
+     dump_enabled = .TRUE.
+  END IF
+
+  CALL GET_ENVIRONMENT_VARIABLE( 'QE_SUBSPACE_DUMP_LIMIT', env, LENGTH=env_len, STATUS=env_status )
+  IF ( env_status == 0 .AND. env_len > 0 ) THEN
+     READ( env(1:env_len), *, IOSTAT=ios ) dump_limit
+     IF ( ios /= 0 ) dump_limit = 8
+  ELSE
+     dump_limit = 8
+  END IF
+
+  CALL GET_ENVIRONMENT_VARIABLE( 'QE_SUBSPACE_MIN_N', env, LENGTH=env_len, STATUS=env_status )
+  IF ( env_status == 0 .AND. env_len > 0 ) THEN
+     READ( env(1:env_len), *, IOSTAT=ios ) min_n
+     IF ( ios /= 0 ) min_n = 0
+  END IF
+
+END SUBROUTINE qe_subspace_trace_init_complex
+
+!----------------------------------------------------------------------------
+SUBROUTINE qe_complex_matrix_stats( n, a, lda, with_identity, frob, max_abs, min_nz_abs, &
+                                    diag_min, diag_max, diag_imag_max, herm_rel, identity_rel )
+  !----------------------------------------------------------------------------
+  IMPLICIT NONE
+  include 'laxlib_kinds.fh'
+  INTEGER, INTENT(IN) :: n, lda
+  LOGICAL, INTENT(IN) :: with_identity
+  COMPLEX(DP), INTENT(IN) :: a(lda,*)
+  REAL(DP), INTENT(OUT) :: frob, max_abs, min_nz_abs
+  REAL(DP), INTENT(OUT) :: diag_min, diag_max, diag_imag_max, herm_rel
+  REAL(DP), INTENT(OUT), OPTIONAL :: identity_rel
+  INTEGER :: i, j
+  REAL(DP) :: abs_ij, norm_sq, herm_sq, ident_sq, denom
+  COMPLEX(DP) :: diff
+
+  norm_sq = 0.0_DP
+  herm_sq = 0.0_DP
+  ident_sq = 0.0_DP
+  max_abs = 0.0_DP
+  min_nz_abs = HUGE( 1.0_DP )
+  diag_min = HUGE( 1.0_DP )
+  diag_max = -HUGE( 1.0_DP )
+  diag_imag_max = 0.0_DP
+
+  DO j = 1, n
+     DO i = 1, n
+        abs_ij = ABS( a(i,j) )
+        norm_sq = norm_sq + abs_ij * abs_ij
+        max_abs = MAX( max_abs, abs_ij )
+        IF ( abs_ij > 0.0_DP ) min_nz_abs = MIN( min_nz_abs, abs_ij )
+        diff = a(i,j) - CONJG( a(j,i) )
+        herm_sq = herm_sq + ABS( diff )**2
+        IF ( with_identity ) THEN
+           IF ( i == j ) THEN
+              ident_sq = ident_sq + ABS( a(i,j) - CMPLX( 1.0_DP, 0.0_DP, KIND=DP ) )**2
+           ELSE
+              ident_sq = ident_sq + ABS( a(i,j) )**2
+           END IF
+        END IF
+     END DO
+     diag_min = MIN( diag_min, DBLE( a(j,j) ) )
+     diag_max = MAX( diag_max, DBLE( a(j,j) ) )
+     diag_imag_max = MAX( diag_imag_max, ABS( AIMAG( a(j,j) ) ) )
+  END DO
+
+  IF ( min_nz_abs == HUGE( 1.0_DP ) ) min_nz_abs = 0.0_DP
+  IF ( n == 0 ) THEN
+     diag_min = 0.0_DP
+     diag_max = 0.0_DP
+  END IF
+
+  frob = SQRT( norm_sq )
+  denom = MAX( frob, TINY( 1.0_DP ) )
+  herm_rel = SQRT( herm_sq ) / denom
+  IF ( PRESENT(identity_rel) ) identity_rel = SQRT( ident_sq ) / denom
+
+END SUBROUTINE qe_complex_matrix_stats
+
+!----------------------------------------------------------------------------
+SUBROUTINE qe_dump_complex_matrix( dump_dir, solver, tag, call_id, n, m, a, lda )
+  !----------------------------------------------------------------------------
+  IMPLICIT NONE
+  include 'laxlib_kinds.fh'
+  CHARACTER(LEN=*), INTENT(IN) :: dump_dir, solver, tag
+  INTEGER, INTENT(IN) :: call_id, n, m, lda
+  COMPLEX(DP), INTENT(IN) :: a(lda,*)
+  CHARACTER(LEN=1024) :: path
+  INTEGER :: unit_id, ios, i, j
+
+  WRITE( path, '(A,"/",A,"_",A,"_call",I6.6,"_n",I0,"_m",I0,".csv")' ) &
+       TRIM(dump_dir), TRIM(solver), TRIM(tag), call_id, n, m
+
+  OPEN( NEWUNIT=unit_id, FILE=TRIM(path), STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+  IF ( ios /= 0 ) RETURN
+
+  WRITE( unit_id, '(A)' ) 'row,col,real,imag'
+  DO j = 1, n
+     DO i = 1, n
+        WRITE( unit_id, '(I0,",",I0,",",ES24.16E3,",",ES24.16E3)' ) &
+             i, j, DBLE( a(i,j) ), AIMAG( a(i,j) )
+     END DO
+  END DO
+
+  CLOSE( unit_id )
+
+END SUBROUTINE qe_dump_complex_matrix
