{
  "schema_version": "v1",
  "description": "Comprehensive architecture family design space for QE DFT acceleration",
  "last_updated": "2026-05-07",
  
  "architecture_families": {
    "pipeline": {
      "family_id": "F1",
      "description": "Pipeline-based architectures",
      "base_characteristics": {
        "control_model": "distributed",
        "interconnect": "FIFO",
        "memory_model": "distributed"
      },
      "variants": {
        "4cluster_standard": {
          "variant_id": "F1.1a",
          "name": "4-Cluster Standard",
          "parameters": {
            "n_clusters": 4,
            "cluster_configs": [
              {"id": "A", "type": "operator_sweep", "pe_count": 256, "memory_kb": 2048, "workload_share": 0.68},
              {"id": "B", "type": "reduced_build", "pe_count": 64, "memory_kb": 512, "workload_share": 0.04},
              {"id": "C", "type": "eigensolver", "pe_count": 128, "memory_kb": 1024, "workload_share": 0.23},
              {"id": "D", "type": "refresh", "pe_count": 32, "memory_kb": 512, "workload_share": 0.05}
            ],
            "interconnect_bandwidth_gbps": 64,
            "fifo_depth": 16,
            "barrier_sync": true,
            "clock_frequency_mhz": 1000
          },
          "performance_model": {
            "type": "pipeline",
            "formula": "T_total = max(T_A, T_B, T_C, T_D) + T_barrier",
            "utilization_formula": "util = sum(T_i) / (N_clusters * T_total)"
          }
        },
        
        "fused_ab": {
          "variant_id": "F1.1b",
          "name": "Fused A+B",
          "parameters": {
            "n_clusters": 3,
            "cluster_configs": [
              {"id": "AB", "type": "operator_build", "pe_count": 320, "memory_kb": 2560, "workload_share": 0.72},
              {"id": "C", "type": "eigensolver", "pe_count": 128, "memory_kb": 1024, "workload_share": 0.23},
              {"id": "D", "type": "refresh", "pe_count": 32, "memory_kb": 512, "workload_share": 0.05}
            ],
            "interconnect_bandwidth_gbps": 64,
            "fusion_benefit": "reduced_barrier_overhead"
          }
        },
        
        "dynamic_pipeline": {
          "variant_id": "F1.1e",
          "name": "Dynamic Pipeline",
          "parameters": {
            "n_clusters": "variable(2-6)",
            "cluster_configs": "runtime_configurable",
            "reconfiguration_time_cycles": 100,
            "interconnect": "configurable_crossbar",
            "adaptive_load_balancing": true
          }
        }
      }
    },
    
    "systolic": {
      "family_id": "F2",
      "description": "Systolic array architectures",
      "base_characteristics": {
        "control_model": "centralized",
        "interconnect": "mesh",
        "memory_model": "unified"
      },
      "variants": {
        "unified_small": {
          "variant_id": "F2.1a",
          "name": "Unified Systolic Small",
          "parameters": {
            "array_dimensions": [32, 32],
            "total_pes": 1024,
            "pe_type": "MAC",
            "pe_frequency_mhz": 1200,
            "dataflow": "weight_stationary",
            "memory_hierarchy": {
              "l1_pe_buffer_bytes": 4096,
              "l2_scratchpad_kb": 512,
              "l3_global_mb": 4
            },
            "specialized_units": {
              "eigensolver": {"type": "jacobi", "parallelism": 8, "max_matrix_size": 32},
              "refresh_unit": {"type": "vector", "width": 64}
            },
            "interconnect": {
              "type": "2D_mesh",
              "bandwidth_gbps": 256,
              "topology": "torus"
            }
          },
          "performance_model": {
            "type": "systolic",
            "formula": "T_GEMM = (M*N*K) / (array_size * f_PE)",
            "utilization_formula": "util = min(1, workload_size / array_size)"
          }
        },
        
        "unified_medium": {
          "variant_id": "F2.1b",
