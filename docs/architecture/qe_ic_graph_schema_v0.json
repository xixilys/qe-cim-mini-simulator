{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qe_ic_graph_schema_v0.json",
  "title": "QE IC graph schema v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_schema_version",
    "graph_id",
    "seed_template_id",
    "workload_class",
    "join_keys",
    "modules",
    "links",
    "flows",
    "placement",
    "estimation_profile",
    "constraints",
    "observability_requirements"
  ],
  "properties": {
    "graph_schema_version": {"const": "qe_ic_graph_schema_v0"},
    "graph_id": {"type": "string"},
    "seed_template_id": {"type": "string"},
    "workload_class": {"type": "string"},
    "join_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "diag_policy", "offload_scope", "resident_policy", "partition_strategy"],
      "properties": {
        "family": {"type": "string"},
        "diag_policy": {"type": "string"},
        "offload_scope": {"type": "string"},
        "resident_policy": {"type": "string"},
        "partition_strategy": {"type": "string"}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "component_ref", "role", "placement"],
        "properties": {
          "instance_id": {"type": "string"},
          "component_ref": {"type": "string"},
          "role": {"type": "string"},
          "placement": {"enum": ["host", "fpga", "shared"]},
          "ports": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link_id", "src", "dst", "payload_kind"],
        "properties": {
          "link_id": {"type": "string"},
          "src": {"type": "string"},
          "dst": {"type": "string"},
          "payload_kind": {"type": "string"},
          "bandwidth_class": {"type": "string"},
          "latency_class": {"type": "string"}
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "steps"],
        "properties": {
          "flow_id": {"type": "string"},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "barriers": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": true
    },
    "estimation_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "observability_requirements": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
