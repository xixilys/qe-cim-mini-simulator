{
  "template_id": "f2_systolic_fpga_dense_path_v1",
  "template_version": "v1",
  "family": "F2",
  "label": "F2 Systolic FPGA Dense Path Scaffold",

  "description": "Stage-A projection scaffold for an F2-compatible dense path that replaces the Cluster A CIM array with a conventional systolic FPGA DSP datapath while preserving the four-cluster partition.",

  "clusters": [
    {
      "cluster_id": "cluster_a",
      "role": "operator_sweep",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "cycle_accurate",
      "resource_budget": {
        "dsp_count": 640,
        "bram_18k_count": 180,
        "lut_count": 130000,
        "uram_count": 40
      }
    },
    {
      "cluster_id": "cluster_b",
      "role": "reduced_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 128,
        "bram_18k_count": 64,
        "lut_count": 36000,
        "uram_count": 4
      }
    },
    {
      "cluster_id": "cluster_c",
      "role": "hardware_diag",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 200,
        "bram_18k_count": 100,
        "lut_count": 80000,
        "uram_count": 20
      }
    },
    {
      "cluster_id": "cluster_d",
      "role": "refresh_residual",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 64,
        "bram_18k_count": 40,
        "lut_count": 24000,
        "uram_count": 2
      }
    }
  ],

  "policies": {
    "diag_policy": "device_first_fallback",
    "offload_scope": "balanced",
    "resident_policy": "fit_first",
    "partition_strategy": "operator__build__diag__refresh"
  },

  "compute_config": {
    "clock_mhz": 300,
    "gemm_tile_size": 32,
    "dsp_array_dims": {
      "rows": 20,
      "cols": 20
    }
  },

  "memory_hierarchy": {
    "l1_buffer_kb": 256,
    "l2_buffer_kb": 1024,
    "resident_budget_scale": 1.0
  },

  "component_overrides": {
    "operator_apply_engine": {
      "component_ref": "operator_apply_engine",
      "implementation_variant": "systolic_dense_fpga_projection_stub",
      "config_overrides": {
        "block_size": 32,
        "systolic_rows": 20,
        "systolic_cols": 20,
        "runtime_support_status": "projection_only"
      }
    },
    "diag_fallback_unit": {
      "component_ref": "diag_fallback_unit",
      "implementation_variant": "host_lapack_fallback_required",
      "config_overrides": {
        "allow_host_fallback": true,
        "preserve_qe_fp64_tolerance": true
      }
    }
  },

  "dse_metadata": {
    "exploration_priority": "high",
    "expected_performance_class": "competitive",
    "risk_level": "medium",
    "tags": ["scaffold_only", "projection_only", "f2_balanced", "systolic_dense", "traditional_fpga", "host_diag_fallback"]
  },

  "notes": {
    "validation_status": "Scaffold only; no new SystemC, RTL, board, or benchmark validation is claimed.",
    "rationale": "Keeps the current F2 partition while exploring a dense DSP systolic substitute for the CIM operator-sweep path.",
    "correctness_policy": "Dense FPGA GEMM must preserve QE FP64 numerical tolerance before any stronger claim is allowed.",
    "projection_boundary": "This template uses schema-supported traditional_fpga_dsp units and projection metadata only."
  }
}
