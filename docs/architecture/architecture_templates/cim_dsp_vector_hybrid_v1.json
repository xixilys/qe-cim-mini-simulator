{
  "template_id": "cim_dsp_vector_hybrid_v1",
  "template_version": "v1",
  "family": "F4",
  "label": "CIM + DSP Vector Hybrid Scaffold",

  "description": "Projection-only scaffold for a mixed CIM/DSP vector fabric. Cluster A explores hybrid CIM+DSP operator sweep placement while B/C/D retain conservative FPGA-style closure, diagonalization, and refresh roles.",

  "clusters": [
    {
      "cluster_id": "cluster_a",
      "role": "operator_sweep",
      "compute_unit": "hybrid_cim_dsp",
      "enabled": true,
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 320,
        "bram_18k_count": 220,
        "lut_count": 170000,
        "uram_count": 60
      }
    },
    {
      "cluster_id": "cluster_b",
      "role": "reduced_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 128,
        "bram_18k_count": 70,
        "lut_count": 42000,
        "uram_count": 8
      }
    },
    {
      "cluster_id": "cluster_c",
      "role": "hardware_diag",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 192,
        "bram_18k_count": 110,
        "lut_count": 85000,
        "uram_count": 20
      }
    },
    {
      "cluster_id": "cluster_d",
      "role": "refresh_residual",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 80,
        "bram_18k_count": 55,
        "lut_count": 36000,
        "uram_count": 4
      }
    }
  ],

  "policies": {
    "diag_policy": "device_first_fallback",
    "offload_scope": "balanced",
    "resident_policy": "fit_first",
    "partition_strategy": "operator__build__diag__refresh"
  },

  "compute_config": {
    "clock_mhz": 275,
    "gemm_tile_size": 32,
    "dsp_array_dims": {
      "rows": 12,
      "cols": 16
    },
    "cim_config": {
      "moduli_count": 16,
      "use_karatsuba": true,
      "residue_width": 32
    }
  },

  "memory_hierarchy": {
    "l1_buffer_kb": 320,
    "l2_buffer_kb": 1280,
    "resident_budget_scale": 1.1
  },

  "component_overrides": {
    "operator_apply_engine": {
      "component_ref": "operator_apply_engine",
      "implementation_variant": "hybrid_cim_dsp_projection_stub",
      "config_overrides": {
        "cim_residue_lanes": 12,
        "dsp_vector_lanes": 16,
        "runtime_support_status": "projection_only"
      }
    },
    "diag_fallback_unit": {
      "component_ref": "diag_fallback_unit",
      "implementation_variant": "host_lapack_fallback_required",
      "config_overrides": {
        "allow_host_fallback": true,
        "preserve_qe_fp64_tolerance": true
      }
    }
  },

  "dse_metadata": {
    "exploration_priority": "medium",
    "expected_performance_class": "competitive",
    "risk_level": "high",
    "tags": ["scaffold_only", "projection_only", "hybrid_cim_dsp", "vector_hybrid", "fp64_correctness_required", "host_diag_fallback"]
  },

  "notes": {
    "validation_status": "Scaffold only; not validated by SystemC, RTL, board data, or QE numerical replay.",
    "correctness_policy": "QE FP64 correctness and existing numerical tolerances remain mandatory; this template does not relax same-correctness requirements.",
    "diag_policy": "Device diagonalization may be projected for exploration, but host LAPACK diagonalization fallback must remain available for generalized Hermitian cases.",
    "projection_boundary": "hybrid_cim_dsp is mapped by the template projector to the generic hybrid SystemC compute category; no new C++ runtime behavior is claimed."
  }
