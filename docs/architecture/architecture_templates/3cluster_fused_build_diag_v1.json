{
  "template_id": "3cluster_fused_build_diag_v1",
  "template_version": "v1",
  "family": "F4",
  "label": "3-Cluster with Fused Build+Diag",
  
  "description": "Reduced cluster count by fusing Cluster B (reduced build) and Cluster C (diag) into a single stage. Reduces inter-cluster communication overhead at the cost of increased complexity.",
  
  "clusters": [
    {
      "cluster_id": "cluster_a",
      "role": "operator_sweep",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "cycle_accurate",
      "resource_budget": {
        "dsp_count": 512,
        "bram_18k_count": 150,
        "lut_count": 100000,
        "uram_count": 30
      }
    },
    {
      "cluster_id": "cluster_b",
      "role": "fused_operator_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": false,
      "fusion_group": "bc_fused",
      "timing_model": "proxy_formula"
    },
    {
      "cluster_id": "cluster_c",
      "role": "hardware_diag",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "fusion_group": "bc_fused",
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 300,
        "bram_18k_count": 150,
        "lut_count": 120000,
        "uram_count": 20
      }
    },
    {
      "cluster_id": "cluster_d",
      "role": "refresh_residual",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 50,
        "bram_18k_count": 30,
        "lut_count": 20000,
        "uram_count": 0
      }
    }
  ],
  
  "policies": {
    "diag_policy": "aggressive_device",
    "offload_scope": "device_heavy",
    "resident_policy": "fit_first",
    "partition_strategy": "operator__build_diag_fused__refresh"
  },
  
  "compute_config": {
    "clock_mhz": 275,
    "gemm_tile_size": 32,
    "dsp_array_dims": {
      "rows": 16,
      "cols": 16
    }
  },
  
  "memory_hierarchy": {
    "l1_buffer_kb": 384,
    "l2_buffer_kb": 1536,
    "resident_budget_scale": 1.2
  },
  
  "component_overrides": {
    "operator_apply_engine": {
      "component_ref": "operator_apply_engine",
      "implementation_variant": "traditional_fpga_gemm",
      "config_overrides": {
        "panel_size": 8,
        "block_size": 32
      }
    },
    "reduced_build_closure_unit": {
      "component_ref": "reduced_build_closure_unit",
      "implementation_variant": "fused_with_diag",
      "config_overrides": {
        "inline_reduction": true,
        "stream_to_eigensolver": true
      }
    },
    "diag_fallback_unit": {
      "component_ref": "diag_fallback_unit",
      "implementation_variant": "device_only_jacobi",
      "config_overrides": {
        "solver_parallelism": 8,
        "max_device_diag_dim": 32,
        "allow_host_fallback": false
      }
    }
  },
  
  "dse_metadata": {
    "exploration_priority": "medium",
    "expected_performance_class": "aggressive",
    "risk_level": "medium",
    "tags": ["scaffold_only", "projection_only", "3cluster", "fused_build_diag", "device_heavy", "experimental"]
  },
  
  "notes": {
    "rationale": "Reduce inter-cluster communication by fusing B+C. Cluster B (4% time) is small enough to merge without dominating.",
    "tradeoffs": "Increased Cluster C complexity and resource usage. Loses modularity. May improve performance if B→C communication was a bottleneck.",
    "expected_performance": "Potentially 5-10% faster than 4-cluster if inter-cluster latency is significant. Needs validation.",
    "validation_status": "Experimental - requires implementation and testing",
    "implementation_notes": "Requires new fused_build_diag module. May need custom SystemC implementation."
  }
}
