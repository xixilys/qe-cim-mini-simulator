{
  "template_id": "4cluster_cim_baseline_v1",
  "template_version": "v1",
  "family": "F2",
  "label": "4-Cluster CIM Array Baseline (Current System)",
  
  "description": "Current baseline architecture with 4-cluster pipeline and CIM Array in Cluster A. This is the reference architecture that all other templates are compared against.",
  
  "clusters": [
    {
      "cluster_id": "cluster_a",
      "role": "operator_sweep",
      "compute_unit": "cim_array",
      "enabled": true,
      "timing_model": "cycle_accurate",
      "resource_budget": {
        "dsp_count": 0,
        "bram_18k_count": 200,
        "lut_count": 150000,
        "uram_count": 50
      }
    },
    {
      "cluster_id": "cluster_b",
      "role": "reduced_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 100,
        "bram_18k_count": 50,
        "lut_count": 30000,
        "uram_count": 0
      }
    },
    {
      "cluster_id": "cluster_c",
      "role": "hardware_diag",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "cycle_accurate",
      "resource_budget": {
        "dsp_count": 200,
        "bram_18k_count": 100,
        "lut_count": 80000,
        "uram_count": 20
      }
    },
    {
      "cluster_id": "cluster_d",
      "role": "refresh_residual",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 50,
        "bram_18k_count": 30,
        "lut_count": 20000,
        "uram_count": 0
      }
    }
  ],
  
  "policies": {
    "diag_policy": "device_first_fallback",
    "offload_scope": "balanced",
    "resident_policy": "fit_first",
    "partition_strategy": "operator__build__diag__refresh"
  },
  
  "compute_config": {
    "clock_mhz": 250,
    "gemm_tile_size": 32,
    "cim_config": {
      "moduli_count": 16,
      "use_karatsuba": true,
      "residue_width": 32
    }
  },
  
  "memory_hierarchy": {
    "l1_buffer_kb": 256,
    "l2_buffer_kb": 1024,
    "resident_budget_scale": 1.0
  },
  
  "component_overrides": {
    "operator_apply_engine": {
      "component_ref": "operator_apply_engine",
      "implementation_variant": "cim_array_ozaki_ii",
      "config_overrides": {
        "panel_size": 8,
        "array_lanes": 16,
        "fft_lanes": 4
      }
    },
    "diag_fallback_unit": {
      "component_ref": "diag_fallback_unit",
      "implementation_variant": "lapack_eigensolver",
      "config_overrides": {
        "solver_parallelism": 4,
        "max_device_diag_dim": 28
      }
    }
  },
  
  "dse_metadata": {
    "exploration_priority": "high",
    "expected_performance_class": "baseline",
    "risk_level": "low",
    "tags": ["baseline", "cim", "4cluster", "f2_balanced", "validated"]
  },
  
  "notes": {
    "performance_characteristics": "68% time in Cluster A (CIM), 23% in Cluster C (diag), 4% in Cluster B, 5% in Cluster D",
    "known_bottlenecks": "Cluster A dominates for large workloads; diag becomes bottleneck for small subspace",
    "validation_status": "Fully validated with si4, si8, graphene workloads",
    "speedup_range": "24.75x (si4) to 125x (si8) vs CPU baseline"
  }
}
