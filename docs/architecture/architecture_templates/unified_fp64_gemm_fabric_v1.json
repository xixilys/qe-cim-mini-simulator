{
  "template_id": "unified_fp64_gemm_fabric_v1",
  "template_version": "v1",
  "family": "F5",
  "label": "Unified FP64 GEMM Fabric Scaffold",

  "description": "Projection-only scaffold for a unified FP64 GEMM fabric that conceptually shares operator-sweep and reduced-build datapaths. Unsupported runtime fusion semantics are recorded as metadata rather than claimed as implemented behavior.",

  "clusters": [
    {
      "cluster_id": "cluster_a",
      "role": "fused_operator_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "fusion_group": "ab_unified_gemm",
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 720,
        "bram_18k_count": 260,
        "lut_count": 210000,
        "uram_count": 72
      }
    },
    {
      "cluster_id": "cluster_b",
      "role": "reduced_build",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": false,
      "fusion_group": "ab_unified_gemm",
      "timing_model": "proxy_formula"
    },
    {
      "cluster_id": "cluster_c",
      "role": "hardware_diag",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "hybrid",
      "resource_budget": {
        "dsp_count": 240,
        "bram_18k_count": 120,
        "lut_count": 90000,
        "uram_count": 24
      }
    },
    {
      "cluster_id": "cluster_d",
      "role": "refresh_residual",
      "compute_unit": "traditional_fpga_dsp",
      "enabled": true,
      "timing_model": "proxy_formula",
      "resource_budget": {
        "dsp_count": 96,
        "bram_18k_count": 64,
        "lut_count": 44000,
        "uram_count": 8
      }
    }
  ],

  "policies": {
    "diag_policy": "device_first_fallback",
    "offload_scope": "device_heavy",
    "resident_policy": "fit_first",
    "partition_strategy": "operator_build_fused__diag__refresh"
  },

  "compute_config": {
    "clock_mhz": 300,
    "gemm_tile_size": 32,
    "dsp_array_dims": {
      "rows": 24,
      "cols": 24
    }
  },

  "memory_hierarchy": {
    "l1_buffer_kb": 512,
    "l2_buffer_kb": 2048,
    "resident_budget_scale": 1.2
  },

  "component_overrides": {
    "operator_build_fabric": {
      "component_ref": "operator_apply_engine",
      "implementation_variant": "unified_fp64_gemm_projection_stub",
      "config_overrides": {
        "shares_operator_and_reduced_build_datapath": true,
        "runtime_support_status": "projection_only",
        "requires_new_scheduler_semantics": true
      }
    },
    "diag_fallback_unit": {
      "component_ref": "diag_fallback_unit",
      "implementation_variant": "host_lapack_fallback_required",
      "config_overrides": {
        "allow_host_fallback": true,
        "preserve_qe_fp64_tolerance": true
      }
    }
  },

  "dse_metadata": {
    "exploration_priority": "medium",
    "expected_performance_class": "aggressive",
    "risk_level": "high",
    "tags": ["scaffold_only", "projection_only", "unified_fp64_gemm", "fused_operator_build", "fp64_correctness_required", "host_diag_fallback"]
  },

  "notes": {
    "validation_status": "Scaffold only; no SystemC, RTL, or board validation is claimed.",
    "correctness_policy": "The unified fabric is a DSE hypothesis only and must preserve QE complex FP64 GEMM and generalized Hermitian solver tolerances.",
    "diag_policy": "Cluster C remains device-first with mandatory host LAPACK fallback for correctness and unsupported device diagonalization cases.",
    "projection_boundary": "fused_operator_build is projected through the closest existing fused-build SystemC category and tagged projection_only; this does not imply new runtime scheduler support."
  }
}
