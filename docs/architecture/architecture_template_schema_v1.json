{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic DSE Architecture Template Schema v1",
  "description": "Domain-neutral schema for reusable architecture candidates consumed by DSE/TLM/SystemC/gem5 flows.",
  "type": "object",
  "required": [
    "template_id",
    "template_version",
    "description",
    "compute_resources",
    "memory_system",
    "interconnect",
    "fidelity_targets",
    "claim_boundary"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "compute_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource_id", "resource_type", "supported_ops"],
        "properties": {
          "resource_id": {"type": "string"},
          "resource_type": {
            "type": "string",
            "enum": ["host_cpu", "gpu", "fpga", "cim", "near_memory", "cgra", "asic", "custom"]
          },
          "clock_mhz": {"type": "number", "minimum": 1},
          "supported_ops": {
            "type": "array",
            "items": {"type": "string"}
          },
          "memory_capacity_mb": {"type": "number", "minimum": 0},
          "power_model": {
            "type": "object",
            "additionalProperties": true
          },
          "microarchitecture": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "memory_system": {
      "type": "object",
      "required": ["host_memory_gb"],
      "properties": {
        "host_memory_gb": {"type": "number", "minimum": 0},
        "hbm_stacks": {"type": "integer", "minimum": 0},
        "scratchpad_mb": {"type": "number", "minimum": 0},
        "coherency_model": {"type": "string"}
      },
      "additionalProperties": true
    },
    "interconnect": {
      "type": "object",
      "required": ["topology", "bandwidth_gbps"],
      "properties": {
        "topology": {"type": "string"},
        "bandwidth_gbps": {"type": "number", "minimum": 0},
        "latency_ns": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "mapping_policy_hints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fidelity_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["l1_analytical", "l2_tlm", "l3_systemc", "l4_gem5_systemc"]
      }
    },
    "claim_boundary": {
      "type": "string",
      "enum": ["template_only", "simulation_candidate", "validated_candidate"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
