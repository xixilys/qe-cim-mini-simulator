{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qe_microarchitecture_catalog_schema_v0",
  "title": "QE microarchitecture catalog schema v0",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "evidence_tier_labels",
    "support_status_values",
    "non_claims",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "qe_microarchitecture_catalog_v0"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "evidence_tier_labels": {
      "type": "array",
      "items": {
        "enum": [
          "survey-catalog",
          "projection-screened",
          "systemc-cycle-accounted",
          "final-best-eligible"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "support_status_values": {
      "type": "array",
      "items": {
        "enum": [
          "unsupported",
          "projection_only",
          "systemc_configurable",
          "current_executor_supported"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/microarchitecture_entry"
      }
    }
  },
  "$defs": {
    "microarchitecture_entry": {
      "type": "object",
      "required": [
        "microarchitecture_id",
        "name",
        "target_stage",
        "architecture_family",
        "summary",
        "provenance",
        "assumptions",
        "parameter_ranges",
        "expected_effects",
        "support_status",
        "model_support_status",
        "supported_evidence_tiers",
        "non_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "microarchitecture_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target_stage": {
          "enum": [
            "operator_sweep",
            "reduced_build",
            "diagonalization",
            "refresh_residual",
            "memory_residency",
            "interconnect",
            "multi_stage"
          ]
        },
        "architecture_family": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameter_ranges": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/parameter_range"
          }
        },
        "expected_effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expected_effect"
          }
        },
        "support_status": {
          "enum": [
            "unsupported",
            "projection_only",
            "systemc_configurable",
            "current_executor_supported"
          ]
        },
        "model_support_status": {
          "type": "object",
          "required": ["status", "notes"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "not_supported",
                "projection_only",
                "configurable_systemc_model",
                "existing_executor_path"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "supporting_artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "supported_evidence_tiers": {
          "type": "array",
          "items": {
            "enum": [
              "survey-catalog",
              "projection-screened",
              "systemc-cycle-accounted"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "source_type", "title", "ref"],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "local_design_template",
            "local_contract",
            "literature_pattern",
            "workload_analysis"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "parameter_range": {
      "type": "object",
      "required": ["kind", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["range", "enum", "unknown"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": ["string", "number", "boolean"]
          },
          "minItems": 1
        },
        "unknown_reason": {
          "type": "string"
        }
      }
    },
    "expected_effect": {
      "type": "object",
      "required": ["metric", "direction", "rationale"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["increase", "decrease", "mixed", "unknown"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
