            },
            "diag_policy": {
              "enum": [
                "cpu_only",
                "device_first_fallback",
                "aggressive_device"
              ]
            },
            "offload_scope": {
              "enum": [
                "single_hotpath",
                "balanced",
                "device_heavy"
              ]
            },
            "resident_policy": {
