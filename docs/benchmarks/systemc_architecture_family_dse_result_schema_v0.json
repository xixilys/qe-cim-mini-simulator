      "properties": {
        "result_id": {
          "type": "string"
        },
        "result_status": {
          "enum": [
            "stub",
            "executed",
            "compared",
            "baseline_missing",
            "baseline_normalization_error",
            "candidate_missing",
            "model_error",
            "compare_error",
            "pending_model_integration",
            "complete",
            "invalid"
          ]
        },
        "source_kind": {
          "enum": [
            "stub",
            "timed_functional_proxy",
            "trace_calibrated_proxy",
            "measured",
            "mixed"
          ]
        },
        "candidate_family": {
          "$ref": "#/$defs/candidate_family"
        },
        "runtime_projection_family": {
          "$ref": "#/$defs/runtime_projection_family"
        },
        "evaluator_backend": {
          "$ref": "#/$defs/evaluator_backend"
        },
        "fidelity_class": {
          "$ref": "#/$defs/fidelity_class"
        },
        "support_status": {
          "$ref": "#/$defs/support_status"
        },
        "support_evidence": {
          "$ref": "#/$defs/support_evidence"
        },
        "workload": {
          "$ref": "#/$defs/workload"
