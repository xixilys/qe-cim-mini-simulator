        "evaluator_backend",
        "fidelity_class",
        "support_status",
        "support_evidence",
        "workload",
        "design_point",
        "comparison_contract",
        "correctness",
        "primary_metrics",
        "secondary_metrics",
        "runtime_observability",
        "graph_evidence",
        "energy_ledger",
        "projection",
        "artifacts",
        "stub_reason"
