{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlair.local/docs/benchmarks/systemc_architecture_family_dse_result_schema_v0.json",
  "title": "Generic SystemC Architecture-Family DSE Result Bundle v0",
  "description": "Machine-readable result bundle for generic L1/L2/L3/L4 DSE evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_bundle_kind", "generated_at_utc", "experiment", "results"],
  "properties": {
    "schema_version": {"const": "systemc_architecture_family_dse_result_schema_v0"},
    "result_bundle_kind": {"const": "generic_architecture_family_dse_bundle"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "experiment": {"$ref": "#/$defs/experiment"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result_row"}},
    "family_summary": {"type": "array", "items": {"$ref": "#/$defs/family_summary"}},
    "candidate_family_summary": {"type": "array", "items": {"$ref": "#/$defs/family_summary"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "producer", "backend_stack", "workloads", "sweep_axes"],
      "properties": {
        "run_id": {"type": "string"},
        "producer": {"type": "string"},
        "backend_stack": {"type": "array", "items": {"type": "string"}},
        "workloads": {"type": "array", "items": {"type": "string"}},
        "sweep_axes": {"type": "array", "items": {"type": "string"}},
        "claim_boundary": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "latency_ms": {"type": "number"},
        "throughput_gops": {"type": "number"},
        "power_w": {"type": "number"},
        "energy_j": {"type": "number"},
        "area_mm2": {"type": "number"},
        "total_data_movement_mb": {"type": "number"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fidelity": {"enum": ["L1", "L2", "L3", "L4"]},
        "backend": {"type": "string"},
        "trusted_for_final_ranking": {"type": "boolean"},
        "artifact_paths": {"type": "array", "items": {"type": "string"}},
        "blocked_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "result_row": {
      "type": "object",
      "additionalProperties": true,
      "required": ["design_point_id", "architecture_id", "workload_id", "status", "metrics", "evidence"],
      "properties": {
        "design_point_id": {"type": "string"},
        "architecture_id": {"type": "string"},
        "workload_id": {"type": "string"},
        "status": {"enum": ["passed", "failed", "blocked", "projected"]},
        "metrics": {"$ref": "#/$defs/metrics"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "uncertainty": {"type": "object", "additionalProperties": true},
        "resource_utilization": {"type": "object", "additionalProperties": true}
      }
    },
    "family_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["architecture_id", "result_count"],
      "properties": {
        "architecture_id": {"type": "string"},
        "result_count": {"type": "integer", "minimum": 0},
        "trusted_result_count": {"type": "integer", "minimum": 0},
        "best_latency_ms": {"type": ["number", "null"]},
        "best_energy_j": {"type": ["number", "null"]}
      }
    }
  }
}
