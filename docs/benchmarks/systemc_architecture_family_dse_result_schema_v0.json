{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlair.local/docs/benchmarks/systemc_architecture_family_dse_result_schema_v0.json",
  "title": "SystemC Architecture Family DSE Result Bundle v0",
  "description": "Machine-readable schema for architecture-family system-level DSE outputs used by the SystemC/QE shell bootstrap flow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_bundle_kind",
    "generated_at_utc",
    "experiment",
    "results",
    "family_summary",
    "candidate_family_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "systemc_architecture_family_dse_result_schema_v0"
    },
    "result_bundle_kind": {
      "const": "architecture_family_dse_bundle"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result_row"
      }
    },
    "family_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family_summary"
      }
    },
    "candidate_family_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_family_summary"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "nullable_boolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullable_integer": {
      "type": [
        "integer",
        "null"
      ]
    },
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullable_string_array": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "candidate_family": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "custom"
      ]
    },
    "runtime_projection_family": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "none",
        "reserved"
      ]
    },
    "evaluator_backend": {
      "enum": [
        "analytical_stub",
        "systemc_timed_functional",
        "trace_proxy",
        "qe_gold_compare",
        "gem5_systemc_cosim_stub",
        "reserved"
      ]
    },
    "fidelity_class": {
      "enum": [
        "stub",
        "projection_only",
        "timed_functional_proxy",
        "trace_calibrated_proxy",
        "correctness_capable",
        "measured",
        "reserved"
      ]
    },
    "support_status": {
      "enum": [
        "native_runtime_supported",
        "projected_runtime_supported",
        "projection_only",
        "stub_reserved",
        "unsupported"
      ]
    },
    "support_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_claim_allowed",
        "native_runtime_evidence_path",
        "projection_reason",
        "future_backend_note",
        "claim_boundary"
      ],
      "properties": {
        "executor_claim_allowed": {
          "type": "boolean"
        },
        "native_runtime_evidence_path": {
          "$ref": "#/$defs/nullable_string"
        },
        "projection_reason": {
          "$ref": "#/$defs/nullable_string"
        },
        "future_backend_note": {
          "$ref": "#/$defs/nullable_string"
        },
        "claim_boundary": {
          "type": "string"
        }
      }
    },
    "range": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "units"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "units": {
          "type": "string"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "producer_script",
        "schema_path",
        "source_model",
        "assumption_set_id",
        "fast_layer_proxy_assumptions_path",
        "fast_layer_proxy_assumptions_schema_version",
        "fast_layer_proxy_assumptions_sha256",
        "qe_tolerance_schema_id",
        "workload_group_contract_path",
        "fairness_power_contract_path",
        "observability_contract_path",
        "algorithm_rewrite_manifest_contract_path",
        "cpu_gpu_baseline_runbook_path",
        "optimized_system_delta_path",
        "gate_contract",
        "sweep_axes",
        "workloads",
        "excluded_engineering_knobs"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "producer_script": {
          "type": "string"
        },
        "schema_path": {
          "type": "string"
        },
        "source_model": {
          "type": "string"
        },
        "assumption_set_id": {
          "type": "string"
        },
        "fast_layer_proxy_assumptions_path": {
          "type": "string"
        },
        "fast_layer_proxy_assumptions_schema_version": {
          "type": "string"
        },
        "fast_layer_proxy_assumptions_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qe_tolerance_schema_id": {
          "type": "string"
        },
        "gate_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_gold_matrix_id",
            "canonical_gold_matrix_version",
            "canonical_gold_workloads",
            "first_priority_convergence_case",
            "first_priority_convergence_family",
            "first_priority_convergence_family_rationale",
            "required_field_order",
            "status_taxonomy"
          ],
          "properties": {
            "canonical_gold_matrix_id": {
              "type": "string"
            },
            "canonical_gold_matrix_version": {
              "type": "string"
            },
            "canonical_gold_workloads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "first_priority_convergence_case": {
              "type": "string"
            },
            "first_priority_convergence_family": {
              "type": "string"
            },
            "first_priority_convergence_family_rationale": {
              "type": "string"
            },
            "required_field_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status_taxonomy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_kind": {
          "enum": [
            "stub",
            "timed_functional_proxy",
            "trace_calibrated_proxy",
            "measured",
            "mixed"
          ]
        },
        "template_driven": {
          "type": "boolean"
        },
        "architecture_template_dir": {
          "$ref": "#/$defs/nullable_string"
        },
        "architecture_template_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "design_space_spec_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "sweep_axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "diag_policy",
            "offload_scope",
            "resident_policy",
            "partition_strategy"
          ],
          "properties": {
            "family": {
              "type": "array",
              "items": {
                "enum": [
                  "F1",
                  "F2",
                  "F3"
                ]
              }
            },
            "diag_policy": {
              "type": "array",
              "items": {
                "enum": [
                  "cpu_only",
                  "device_first_fallback",
                  "aggressive_device"
                ]
              }
            },
            "offload_scope": {
              "type": "array",
              "items": {
                "enum": [
                  "single_hotpath",
                  "balanced",
                  "device_heavy"
                ]
              }
            },
            "resident_policy": {
              "type": "array",
              "items": {
                "enum": [
                  "fit_first",
                  "spill_tolerant"
                ]
              }
            },
            "partition_strategy": {
              "type": "array",
              "items": {
                "enum": [
                  "single_hotpath_partition",
                  "operator_build_fused__diag__refresh",
                  "operator__build__diag__refresh",
                  "operator__build_diag_fused__refresh",
                  "operator_build_fused__diag_refresh_fused"
                ]
              }
            },
            "architecture_template_id": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "workloads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workload"
          }
        },
        "excluded_engineering_knobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workload_group_contract_path": {
          "type": "string"
        },
        "fairness_power_contract_path": {
          "type": "string"
        },
        "observability_contract_path": {
          "type": "string"
        },
        "optimized_system_delta_path": {
          "type": "string"
        },
        "algorithm_rewrite_manifest_contract_path": {
          "type": "string"
        },
        "cpu_gpu_baseline_runbook_path": {
          "type": "string"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "label",
        "software_family",
        "flow_family",
        "trait_bucket",
        "lane",
        "gold_required",
        "first_priority_convergence_case"
      ],
      "properties": {
        "workload_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "software_family": {
          "enum": [
            "QE",
            "VASP",
            "CP2K"
          ]
        },
        "flow_family": {
          "type": "string"
        },
        "trait_bucket": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "qe_gold",
            "qe_next_stage_mainline",
            "qe_generalization",
            "qe_signature_stage_b",
            "portability"
          ]
        },
        "gold_required": {
          "type": "boolean"
        },
        "first_priority_convergence_case": {
          "type": "boolean"
        },
        "signature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "property_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "pseudopotential_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "solver_path_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "workload_topology": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_scf_extension_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "projector_pressure": {
          "type": [
            "string",
            "null"
          ]
        },
        "nonlocal_pressure": {
          "type": [
            "string",
            "null"
          ]
        },
        "generalized_ratio_bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "diag_dominance": {
          "type": [
            "string",
            "null"
          ]
        },
        "fft_grid_pressure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "result_status",
        "source_kind",
        "candidate_family",
