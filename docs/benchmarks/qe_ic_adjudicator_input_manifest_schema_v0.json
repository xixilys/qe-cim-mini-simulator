{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlair.local/docs/benchmarks/qe_ic_adjudicator_input_manifest_schema_v0.json",
  "title": "QE IC Adjudicator Input Manifest v0",
  "description": "Machine-readable intake manifest for the QE IC high-fidelity adjudicator. Freezes required input surfaces, the normalized identity tuple, cohort authority, and hard-block join-key semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "generated_at_utc",
    "authority_contract_id",
    "input_manifest_contract_id",
    "identity_tuple_scope",
    "normalized_identity_field_order",
    "family_alias_normalization",
    "secondary_provenance_fields",
    "normalized_identity_tuple",
    "input_surfaces",
    "cohort_policy",
    "hard_block_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "qe_ic_adjudicator_input_manifest_schema_v0"
    },
    "manifest_kind": {
      "const": "qe_ic_adjudicator_input_manifest"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "authority_contract_id": {
      "const": "qe_ic_adjudicator_authority_contract_v0"
    },
    "input_manifest_contract_id": {
      "const": "qe_ic_adjudicator_input_manifest_contract_v0"
    },
    "identity_tuple_scope": {
      "const": "group_family_policy_contract_identity__not_per_workload_or_run_identity"
    },
    "normalized_identity_field_order": {
      "const": [
        "workload_group_id",
        "family",
        "diag_policy",
        "offload_scope",
        "resident_policy",
        "partition_strategy",
        "assumption_set_id",
        "qe_tolerance_schema_id",
        "accounting_boundary_id",
        "fairness_policy_id",
        "power_boundary_id",
        "observability_contract_id",
        "algorithm_rewrite_manifest_id"
      ]
    },
    "family_alias_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_field",
        "accepted_upstream_aliases"
      ],
      "properties": {
        "normalized_field": {
          "const": "family"
        },
        "accepted_upstream_aliases": {
          "const": [
            "family",
            "architecture_family"
          ]
        }
      }
    },
    "secondary_provenance_fields": {
      "const": [
        "workload_id",
        "request_id",
        "scf_iteration",
        "episode_id",
        "algorithm_contract_deviation"
      ]
    },
    "normalized_identity_tuple": {
      "$ref": "#/$defs/normalized_identity_tuple"
    },
    "input_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dse_subject_row",
        "family_summary_context",
        "gpu_annex_summary",
        "phase1_evidence_closure",
        "stage_main_evidence"
      ],
      "properties": {
        "dse_subject_row": {
          "allOf": [
            {
              "$ref": "#/$defs/exact_match_surface_ref"
            },
            {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "const": "dse_result_row"
                }
              }
            }
          ]
        },
        "family_summary_context": {
          "$ref": "#/$defs/family_summary_context"
        },
        "gpu_annex_summary": {
          "allOf": [
            {
              "$ref": "#/$defs/exact_match_surface_ref"
            },
            {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "const": "gpu_annex_summary"
                }
              }
            }
          ]
        },
        "phase1_evidence_closure": {
          "allOf": [
            {
              "$ref": "#/$defs/exact_match_surface_ref"
            },
            {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "const": "phase1_evidence_closure"
                }
              }
            }
          ]
        },
        "stage_main_evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/exact_match_surface_ref"
            },
            {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "const": "stage_main_recommendation_evidence"
                }
              }
            }
          ]
        }
      }
    },
    "cohort_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compared_cohorts",
        "authority_cohort",
        "canonical_family_profile_role",
        "trusted_point_per_family_role",
        "best_performance_point_role",
        "divergence_reporting",
        "authority_fallback_rule"
      ],
      "properties": {
        "compared_cohorts": {
          "const": [
            "canonical_family_profile",
            "trusted_point_per_family",
            "best_performance_point"
          ]
        },
        "authority_cohort": {
          "const": "trusted_point_per_family"
        },
        "canonical_family_profile_role": {
          "const": "explain_only"
        },
        "trusted_point_per_family_role": {
          "const": "recommendation_authority"
        },
        "best_performance_point_role": {
          "const": "divergence_probe_only"
        },
        "divergence_reporting": {
          "const": [
            "authority_vs_canonical_divergence",
            "authority_vs_best_performance_divergence"
          ]
        },
        "authority_fallback_rule": {
          "const": "no_recommendation_if_no_trusted_point_per_family_survives_hard_blocks"
        }
      }
    },
    "hard_block_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_eligibility_rule",
        "hard_block_statuses",
        "missing_identity_status",
        "drift_identity_status",
        "hard_block_action",
        "family_authority_rule",
        "manifest_authority_rule"
      ],
      "properties": {
        "comparison_eligibility_rule": {
          "const": "exact_match_required_between_dse_subject_row_and_all_required_closure_artifacts_after_normalizing_architecture_family_to_family"
        },
        "hard_block_statuses": {
          "const": [
            "join_key_missing",
            "join_key_drift"
          ]
        },
        "missing_identity_status": {
          "const": "join_key_missing"
        },
        "drift_identity_status": {
          "const": "join_key_drift"
        },
        "hard_block_action": {
          "const": "exclude_from_comparison_and_block_recommendation_authority"
        },
        "family_authority_rule": {
          "const": "a_family_is_authority_ineligible_when_its_trusted_point_or_required_closure_artifacts_are_hard_blocked"
        },
        "manifest_authority_rule": {
          "const": "if_all_families_are_authority_ineligible_the_adjudicator_must_return_no_recommendation"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "normalized_identity_field_name": {
      "enum": [
        "workload_group_id",
        "family",
        "diag_policy",
        "offload_scope",
        "resident_policy",
        "partition_strategy",
        "assumption_set_id",
        "qe_tolerance_schema_id",
        "accounting_boundary_id",
        "fairness_policy_id",
        "power_boundary_id",
        "observability_contract_id",
        "algorithm_rewrite_manifest_id"
      ]
    },
    "normalized_identity_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_group_id",
        "family",
        "diag_policy",
        "offload_scope",
        "resident_policy",
        "partition_strategy",
        "assumption_set_id",
        "qe_tolerance_schema_id",
        "accounting_boundary_id",
        "fairness_policy_id",
        "power_boundary_id",
        "observability_contract_id",
        "algorithm_rewrite_manifest_id"
      ],
      "properties": {
        "workload_group_id": {
          "type": "string"
        },
        "family": {
          "enum": [
            "F1",
            "F2",
            "F3"
          ]
        },
        "diag_policy": {
          "enum": [
            "cpu_only",
            "device_first_fallback",
            "aggressive_device"
          ]
        },
        "offload_scope": {
          "enum": [
            "single_hotpath",
            "balanced",
            "device_heavy"
          ]
        },
        "resident_policy": {
          "enum": [
            "fit_first",
            "spill_tolerant"
          ]
        },
        "partition_strategy": {
          "enum": [
            "single_hotpath_partition",
            "operator_build_fused__diag__refresh",
            "operator__build__diag__refresh",
            "operator__build_diag_fused__refresh",
            "operator_build_fused__diag_refresh_fused"
          ]
        },
        "assumption_set_id": {
          "type": "string"
        },
        "qe_tolerance_schema_id": {
          "type": "string"
        },
        "accounting_boundary_id": {
          "type": "string"
        },
        "fairness_policy_id": {
          "type": "string"
        },
        "power_boundary_id": {
          "type": "string"
        },
        "observability_contract_id": {
          "type": "string"
        },
        "algorithm_rewrite_manifest_id": {
          "type": "string"
        }
      }
    },
    "join_key_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_identity_fields",
        "status",
        "blocking",
        "missing_fields",
        "drift_fields"
      ],
      "properties": {
        "normalized_identity_fields": {
          "const": [
            "workload_group_id",
            "family",
            "diag_policy",
            "offload_scope",
            "resident_policy",
            "partition_strategy",
            "assumption_set_id",
            "qe_tolerance_schema_id",
            "accounting_boundary_id",
            "fairness_policy_id",
            "power_boundary_id",
            "observability_contract_id",
            "algorithm_rewrite_manifest_id"
          ]
        },
        "status": {
          "enum": [
            "exact_match",
            "join_key_missing",
            "join_key_drift"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalized_identity_field_name"
          },
          "uniqueItems": true
        },
        "drift_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalized_identity_field_name"
          },
          "uniqueItems": true
        }
      }
    },
    "exact_match_surface_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_kind",
        "surface_id",
        "join_key_evaluation"
      ],
      "properties": {
        "artifact_path": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "surface_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "join_key_evaluation": {
          "$ref": "#/$defs/join_key_evaluation"
        }
      }
    },
    "family_summary_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_kind",
        "binding_rule",
        "binding_family_field"
      ],
      "properties": {
        "artifact_path": {
          "type": "string"
        },
        "artifact_kind": {
          "const": "family_summary"
        },
        "binding_rule": {
          "const": "family_summary_is_advisory_only_and_must_resolve_through_exact_match_dse_rows"
        },
        "binding_family_field": {
          "const": "family"
        }
      }
    }
  }
}
