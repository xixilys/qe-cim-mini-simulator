{
  "schema_name": "qe_gold_numerical_tolerance_schema_v0",
  "schema_version": "2026-04-13",
  "scope": "QE gold correctness lane for system-level DSE architecture-family comparison",
  "description": "Canonical tolerance schema for QE CPU-only gold checks. v0 keeps the gate intentionally small: final total energy must match within DFT-grade tolerance, and final residual-threshold / converged state must match exactly.",
  "canonical_payload_shape": {
    "case_id": "si8_pbe_nc",
    "final": {
      "total_energy_ry": -62.28748772,
      "residual_threshold_reached": true,
      "converged": true,
      "scf_iterations": 8
    }
  },
  "pass_rule": {
    "name": "all_required_fields_must_pass",
    "description": "A QE gold comparison passes only when every required field passes its field-level rule.",
    "required_fields": [
      "final_total_energy_ry",
      "final_converged",
      "final_residual_threshold_reached"
    ]
  },
  "stdout_fallback": {
    "enabled": true,
    "description": "If a JSON file does not expose canonical fields directly but points at a QE stdout file, the helper may recover the canonical fields from stdout.",
    "stdout_path_candidates": [
      "stdout_file",
      "paths.stdout",
      "metadata.stdout_file"
    ],
    "regex": {
      "total_energy_ry": "^\\s*!?\\s*total energy\\s*=\\s*(?P<value>[-+0-9.EeDd]+)\\s+Ry\\s*$",
      "estimated_scf_accuracy_ry": "^\\s*estimated scf accuracy\\s*<\\s*(?P<value>[-+0-9.EeDd]+)\\s+Ry\\s*$",
      "converged_iterations": "convergence has been achieved in\\s+(?P<value>\\d+)\\s+iterations",
      "iteration_number": "^\\s*iteration #\\s*(?P<value>\\d+)"
    }
  },
  "fields": [
    {
      "name": "case_id",
      "kind": "string",
      "required": false,
      "comparison": "exact_if_both_present",
      "description": "Context field used to guard against cross-case comparisons.",
      "baseline_paths": [
        "case_id",
        "metadata.case_id",
        "final.case_id"
      ],
      "candidate_paths": [
        "case_id",
        "metadata.case_id",
        "final.case_id"
      ]
    },
    {
      "name": "final_total_energy_ry",
      "kind": "float",
      "required": true,
      "units": "Ry",
      "comparison": "abs_or_rel",
      "abs_tol": 1e-08,
      "rel_tol": 1e-10,
      "scale_floor": 1.0,
      "description": "Final total energy after the SCF shell finishes. This is the only mandatory numeric tolerance in v0.",
      "baseline_paths": [
        "final.total_energy_ry",
        "final_state.total_energy_ry",
        "final_state.total_energy",
        "total_energy_ry",
        "total_energy"
      ],
      "candidate_paths": [
        "final.total_energy_ry",
        "final_state.total_energy_ry",
        "final_state.total_energy",
        "total_energy_ry",
        "total_energy"
      ]
    },
    {
      "name": "final_converged",
      "kind": "bool",
      "required": true,
      "comparison": "exact",
      "description": "Final converged / not-converged state of the whole SCF shell.",
      "baseline_paths": [
        "final.converged",
        "final_state.converged",
        "converged"
      ],
      "candidate_paths": [
        "final.converged",
        "final_state.converged",
        "converged"
      ]
    },
    {
      "name": "final_residual_threshold_reached",
      "kind": "bool",
      "required": true,
      "comparison": "exact",
      "description": "Whether the final residual / SCF-accuracy threshold was reached. v0 allows a bootstrap inference from final_converged only when this field is absent.",
      "baseline_paths": [
        "final.residual_threshold_reached",
        "final.residual_gate_passed",
        "residual_threshold_reached",
        "convergence.residual_threshold_reached"
      ],
      "candidate_paths": [
        "final.residual_threshold_reached",
        "final.residual_gate_passed",
        "residual_threshold_reached",
        "convergence.residual_threshold_reached"
      ],
      "fallback_from_field": "final_converged",
      "fallback_label": "bootstrap_from_final_converged"
    },
    {
      "name": "scf_iterations",
      "kind": "int",
      "required": false,
      "comparison": "exact",
      "report_only": true,
      "description": "Auxiliary diagnostic field: useful for interpreting a pass/fail result, but not part of the gold gate in v0.",
      "baseline_paths": [
        "final.scf_iterations",
        "scf_iterations",
        "iterations",
        "final.iterations"
      ],
      "candidate_paths": [
        "final.scf_iterations",
        "scf_iterations",
        "iterations",
        "final.iterations"
      ]
    }
  ]
}
