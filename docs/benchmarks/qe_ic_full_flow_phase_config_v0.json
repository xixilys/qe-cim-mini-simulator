  "taxonomy": {
    "source_kind": [
      "stub",
      "timed_functional_proxy",
      "trace_calibrated_proxy",
      "measured",
      "mixed"
    ],
    "gpu_readiness_states": [
      "pending",
      "running",
      "measured_not_yet_validated",
      "reference_only",
      "deferred",
      "thesis_eligible"
    ],
    "decisive_for_case": {
      "type": "boolean",
      "independent_from_gpu_readiness_state": true,
      "meaning": "current_best_case_row_after_existing_readiness_and_closure_gates"
    }
  },
  "deliverables": {
    "ranking_outputs": [
      "primary_candidate",
      "fallback_candidate"
    ],
    "grounded_claim_rule": "mainline DSE cases must be ranked by time first, energy second; shortlisted points must survive numerically grounded validation before promotion"
  },
  "promotion_policy": {
    "state_machine": [
      "reject",
      "explain-only",
      "promotion-eligible"
    ],
    "reject_statuses": [
      "model_error",
      "candidate_missing",
      "baseline_missing",
      "baseline_normalization_error",
      "compare_error"
    ],
    "explain_only_when": [
      "missing_fast_layer_metrics",
      "ranking_grade_ready_false"
    ],
    "tie_band_rule": {
      "kind": "relative_time_margin_after_energy_tiebreak",
      "max_relative_margin": 0.05,
      "source_contract_path": "docs/benchmarks/qe_simulator_board_observability_contract_v0.md"
    }
  },
  "specialization": {
    "signature_taxonomy_ref": "docs/benchmarks/qe_ic_computational_signature_taxonomy_v0.md",
    "case_signature_matrix_ref": "docs/benchmarks/qe_ic_case_signature_matrix_v0.json",
    "bringup_signature_cases": [
      "si4_pbe_uspp_small",
      "graphene_pbe_uspp",
      "si8_pbe_nc"
    ],
    "stage_b_nonblocking_signature_cases": [
      "au_slab_subspace",
      "sic32_subspace"
    ]
  },
  "strategy_axes": {
    "partition_strategy_field": "partition_strategy",
    "partition_strategy_values": [
      "single_hotpath_partition",
      "operator_build_fused__diag__refresh",
      "operator__build__diag__refresh",
      "operator__build_diag_fused__refresh",
      "operator_build_fused__diag_refresh_fused"
    ],
    "design_point_identity_fields": [
      "family",
      "diag_policy",
      "offload_scope",
      "resident_policy",
      "partition_strategy"
    ],
    "sweep_result_identity_includes": [
      "partition_strategy"
    ]
  },
  "artifact_semantics": {
    "best_trusted_point_field": "recommended_family",
    "best_performance_candidate_requires": [
      "signature_id",
      "family",
      "diag_policy",
      "offload_scope",
      "resident_policy",
      "partition_strategy"
    ],
    "stage_b_release_gate_mode": "nonblocking_until_explicit_gate_change"
  }
