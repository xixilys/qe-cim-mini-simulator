    "accurate_layer": {
      "role": "correctness_capable_anchor_and_candidate_validation",
      "lane_owner": "numerically_grounded",
      "anchor_cases": [
        "si8_pbe_nc"
      ],
      "coverage_cases": [
        "si8_pbe_uspp"
      ],
      "generalization_cases": [
        "si4_pbe_uspp_small",
        "graphene_pbe_uspp",
        "graphene_pbe_paw",
        "h2_tiny"
      ],
      "generalization_release_blocking": false,
      "candidate_validation": "shortlisted_only",
