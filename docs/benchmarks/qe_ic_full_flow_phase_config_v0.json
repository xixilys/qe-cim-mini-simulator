        "required_in": [
          "simulator_row",
          "gpu_baseline_row",
          "board_row"
        ],
        "note": "Preserve baseline family sweep semantics; exporter emits observability alias."
      },
      {
        "overlay_field": "diag_policy",
        "export_field": "diag_policy",
        "required_in": [
          "simulator_row",
          "gpu_baseline_row",
          "board_row"
        ]
      },
      {
