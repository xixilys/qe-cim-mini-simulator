{
  "schema_version": "qe_next_stage_dse_simulator_phase_config_v0",
  "phase_id": "qe_next_stage_dse_simulator_v0",
  "scope": {
    "software_family": "QE",
    "rtl_deferred": true,
    "architecture_families_primary": [
      "F1",
      "F2"
    ],
    "architecture_families_conditional": [
      "F3"
    ]
  },
  "layers": {
    "fast_layer": {
      "role": "dse_system_simulator",
      "main_cases": [
        "si4_pbe_uspp_small",
        "graphene_pbe_uspp"
      ],
      "primary_objective": "time_to_convergence_s",
      "secondary_objective": "energy_to_convergence_j",
      "constraint_metrics": [
        "bytes_moved_to_convergence",
        "fallback_ratio",
        "spill_ratio"
      ]
    },
    "accurate_layer": {
      "role": "correctness_capable_anchor_and_candidate_validation",
      "anchor_cases": [
        "si8_pbe_nc"
      ],
      "coverage_cases": [
        "si8_pbe_uspp"
      ],
      "generalization_cases": [
        "si4_pbe_uspp_small",
        "graphene_pbe_uspp",
        "graphene_pbe_paw",
        "h2_tiny"
      ],
      "generalization_release_blocking": false,
      "candidate_validation": "shortlisted_only",
      "required_checks": [
        "gold_pass",
        "convergence_comparable_pass",
        "final_total_energy_ry",
        "final_converged",
        "final_residual_threshold_reached"
      ]
    }
  },
  "deliverables": {
    "ranking_outputs": [
      "primary_candidate",
      "fallback_candidate"
    ],
    "grounded_claim_rule": "mainline DSE cases must be ranked by time first, energy second; shortlisted points must survive accurate-layer validation before promotion"
  },
  "promotion_policy": {
    "state_machine": [
      "reject",
      "explain-only",
      "promotion-eligible"
    ],
    "reject_statuses": [
      "model_error",
      "candidate_missing",
      "baseline_missing",
      "baseline_normalization_error",
      "compare_error"
    ],
    "explain_only_when": [
      "missing_fast_layer_metrics",
      "ranking_grade_ready_false"
    ],
    "tie_band_rule": {
      "kind": "relative_time_margin_after_energy_tiebreak",
      "max_relative_margin": 0.05,
      "source_contract_path": "docs/benchmarks/qe_simulator_board_observability_contract_v0.md"
    }
  }
}
