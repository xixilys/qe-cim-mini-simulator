{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlair.local/docs/benchmarks/workload_ir_schema_v0.json",
  "title": "Generic DSE Workload IR Schema v0",
  "description": "Domain-neutral workload graph exchanged between workload importers, DSE mapping, and simulation backends.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "workload_id",
    "workload_family",
    "compute_graph"
  ],
  "properties": {
    "schema_version": {
      "const": "workload_ir_schema_v0"
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "workload_family": {
      "type": "string",
      "description": "Profile-declared family such as ml_tensor, sparse_la, stencil_streaming, graph_analytics, database_vector_search, or dynamic_custom."
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "compute_graph": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "calibration": {
      "type": "object",
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "claim_boundary": {
          "type": "string"
        },
        "required_coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "importer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "importer_id": {
          "type": "string"
        },
        "importer_version": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "shape",
        "dtype"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dtype": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "byte_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "op_type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "op_type": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_specs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tensor"
          }
        },
        "output_specs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tensor"
          }
        },
        "estimated_flops": {
          "type": "number",
          "minimum": 0
        },
        "estimated_memory_bytes": {
          "type": "number",
          "minimum": 0
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "tensor_name": {
          "type": "string"
        },
        "tensor_spec": {
          "$ref": "#/$defs/tensor"
        },
        "edge_kind": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "cycle_semantics": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "region_id",
        "region_type",
        "node_ids"
      ],
      "properties": {
        "region_id": {
          "type": "string"
        },
        "region_type": {
          "type": "string"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantics": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
