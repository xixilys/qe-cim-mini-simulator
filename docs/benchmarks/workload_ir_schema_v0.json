{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QE DSE Workload IR Schema v0",
  "description": "Intermediate Representation for workload characterization output, consumed by architecture exploration",
  
  "type": "object",
  "required": ["schema_version", "workload_id", "compute_graph", "execution_profile", "memory_profile", "data_movement"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["v0"],
      "description": "Schema version for compatibility"
    },
    
    "workload_id": {
      "type": "string",
      "description": "Unique workload identifier",
      "examples": ["qe_dft_si8_uspp", "qe_dft_graphene_paw"]
    },
    
    "source": {
      "type": "object",
      "properties": {
        "software": {"type": "string", "description": "Source software name"},
        "version": {"type": "string", "description": "Software version"},
        "case": {"type": "string", "description": "Case name"},
        "trace_date": {"type": "string", "format": "date", "description": "Trace generation date"}
      }
    },
    
    "compute_graph": {
      "type": "object",
      "description": "Compute graph representing workload kernels and data flow",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "dominance"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Kernel identifier",
                "examples": ["h_psi", "s_psi", "cdiaghg", "refresh"]
              },
              "type": {
                "type": "string",
                "enum": ["GEMM", "EIGEN", "VECTOR", "REDUCTION", "FFT", "MEMORY", "CONTROL"],
                "description": "Kernel computation type"
              },
              "dominance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Workload share (0-1)"
              },
              "flops_per_call": {
                "type": "number",
                "description": "FLOPs per kernel invocation"
              },
              "call_count": {
                "type": "integer",
                "description": "Number of invocations per iteration"
              },
              "precision": {
                "type": "string",
                "enum": ["FP64", "FP32", "FP16", "INT8", "MIXED"],
                "description": "Numerical precision"
              },
              "dimensions": {
                "type": "object",
                "description": "Symbolic dimensions",
                "additionalProperties": {"type": "string"}
              },
              "typical_sizes": {
                "type": "object",
                "description": "Typical dimension ranges",
                "additionalProperties": {
                  "type": "array",
                  "items": {"type": "integer"},
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "arithmetic_intensity": {
                "type": "number",
                "description": "FLOPs per byte moved"
              },
              "memory_access_pattern": {
                "type": "string",
                "enum": ["sequential", "strided", "random", "streaming", "reuse"]
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "description": "Source node ID"},
              "to": {"type": "string", "description": "Destination node ID"},
              "data_type": {"type": "string", "description": "Data type being transferred"},
              "volume_mb": {"type": "number", "description": "Data volume in MB"},
              "pattern": {"type": "string", "enum": ["producer_consumer", "reduction", "broadcast", "gather"]},
              "frequency": {"type": "string", "enum": ["per_iter", "per_call", "once"]}
            }
          }
        }
      }
    },
    
    "execution_profile": {
      "type": "object",
      "description": "Execution characteristics",
      "properties": {
        "total_iterations": {
          "type": "integer",
          "description": "Typical iteration count"
        },
        "convergence_pattern": {
          "type": "string",
          "enum": ["monotonic", "oscillating_decay", "plateau", "divergent"]
        },
        "dominant_solver": {
          "type": "string",
          "description": "Primary solver algorithm"
        },
        "solver_fallbacks": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Fallback solver algorithms"
        },
        "parallelism": {
          "type": "object",
          "properties": {
            "kpoints": {"type": "integer"},
            "bands": {"type": "string"},
            "gvectors": {"type": "string"}
          }
        },
        "generalized_path_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction using generalized eigensolver path"
        }
      }
    },
    
    "memory_profile": {
      "type": "object",
      "description": "Memory access characteristics",
      "properties": {
        "working_set_mb": {
          "type": "number",
          "description": "Total working set size"
        },
        "resident_set_mb": {
          "type": "number",
          "description": "Resident memory size"
        },
        "memory_access_pattern": {
          "type": "string",
          "enum": ["streaming", "streaming_with_reuse", "random", "cache_friendly"]
        },
        "reuse_distance": {
          "type": "string",
          "enum": ["short", "medium", "long"]
        },
        "memory_hierarchy_usage": {
          "type": "object",
          "properties": {
            "l1_hit_rate": {"type": "number"},
            "l2_hit_rate": {"type": "number"},
            "l3_hit_rate": {"type": "number"}
          }
        }
      }
    },
    
    "data_movement": {
      "type": "object",
      "description": "Data movement characteristics",
      "properties": {
        "host_to_device_mb_per_iter": {
          "type": "number",
          "description": "Host to device transfer per iteration"
        },
        "device_to_host_mb_per_iter": {
          "type": "number",
          "description": "Device to host transfer per iteration"
        },
        "device_internal_mb_per_iter": {
          "type": "number",
          "description": "Internal device data movement per iteration"
        },
        "dominant_traffic": {
          "type": "string",
          "description": "Primary data movement pattern"
        },
        "bandwidth_requirement_gbps": {
          "type": "number",
          "description": "Required memory bandwidth"
        }
      }
    },
    
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "generation_timestamp": {"type": "string", "format": "date-time"},
        "trace_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "validation_status": {
          "type": "string",
          "enum": ["validated", "partial", "estimated"]
        }
      }
    }
  }
}
