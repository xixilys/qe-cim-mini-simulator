&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'mos2_pbe',
  pseudo_dir = '/mnt/f/phd/year_2/project/dft_accelerate/soft/qe-7.5/pseudo/',
  outdir = '/mnt/f/phd/year_2/project/dft_accelerate/tmp_qe_workload/mos2_pbe/',
  disk_io = 'low',
  assume_isolated = '2D'
/
&SYSTEM
  ibrav = 4,
  celldm(1) = 5.47,
  celldm(3) = 5.000,
  nat = 3,
  ntyp = 2,
  ecutwfc = 60.0,
  ecutrho = 480.0,
  nbnd = 30,
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.01
/
&ELECTRONS
  electron_maxstep = 100,
  mixing_mode = 'plain',
  mixing_beta = 0.7,
  conv_thr = 1.0d-8
/
