&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'gaas_pbe',
  pseudo_dir = '/mnt/f/phd/year_2/project/dft_accelerate/soft/qe-7.5/external/wannier90/pseudo/',
  outdir = '/mnt/f/phd/year_2/project/dft_accelerate/tmp_qe_workload/gaas_pbe/',
  disk_io = 'low'
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 10.60,
