&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'si8_pbe0_uspp',
  pseudo_dir = '/Volumes/remote/phd/year_2/project/dft加速/soft/qe-7.5/benchmark/',
  outdir = '/Volumes/remote/phd/year_2/project/dft加速/tmp_qe_workload/si8_pbe0_uspp/',
  disk_io = 'none'
/
&SYSTEM
  ibrav = 1,
  celldm(1) = 10.20,
  nat = 8,
  ntyp = 1,
  ecutwfc = 30.0,
  ecutrho = 120.0,
  input_dft = 'pbe0',
  nqx1 = 1,
  nqx2 = 1,
  nqx3 = 1,
  exxdiv_treatment = 'gygi-baldereschi'
/
&ELECTRONS
  electron_maxstep = 4,
  diagonalization = 'cg',
  mixing_mode = 'plain',
  mixing_beta = 0.7,
  conv_thr = 1.0d-6
/
