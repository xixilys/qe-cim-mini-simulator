&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'fe_subspace'
  pseudo_dir = '/Volumes/remote/phd/year_2/project/dft加速/soft/qe-7.5/benchmark/'
  outdir = '/Volumes/remote/phd/year_2/project/dft加速/tmp_fe_subspace_out/'
/
&SYSTEM
  ibrav = 3
  celldm(1) = 5.42
  nat = 1
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  nspin = 2
  starting_magnetization(1) = 0.6
  occupations = 'smearing'
  degauss = 0.02
  smearing = 'mv'
/
&ELECTRONS
  electron_maxstep = 4
  conv_thr = 1.0d-8
  mixing_beta = 0.7
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
ATOMIC_POSITIONS alat
  Fe 0.00 0.00 0.00
K_POINTS automatic
  8 8 8 0 0 0
