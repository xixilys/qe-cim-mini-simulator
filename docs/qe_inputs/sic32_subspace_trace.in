&control
    calculation = 'scf'
    restart_mode='from_scratch'
    prefix='sic32_subspace'
    pseudo_dir = '/Volumes/remote/phd/year_2/project/dft加速/soft/qe-7.5/benchmark/'
    outdir='/Volumes/remote/phd/year_2/project/dft加速/tmp_sic32_subspace_out/'
    tprnfor = .true.
    disk_io = 'none'
 /
&system
    ibrav=1,
    celldm(1)=24.0,
    nat=32, ntyp=2,
    ecutwfc = 25.0,
    ecutrho = 100.0,
    input_dft = 'pbe0',
    nqx1 = 1, nqx2 = 1, nqx3 = 1,
    exxdiv_treatment = 'gygi-baldereschi'
 /
&electrons
    electron_maxstep = 4
    diagonalization='david'
    mixing_mode = 'plain'
    mixing_beta = 0.7
    conv_thr =  1.0d-4
 /
