+              WRITE(qe_json_unit,'(A)') '  "single_hpsi_call_smoke_only": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '  "single_hpsi_call_smoke_only": false,'
+           ENDIF
+           IF ( qe_sidecar_success_count == qe_hpsi_observed_call_count .AND. qe_sidecar_failure_count == 0 ) THEN
+              WRITE(qe_json_unit,'(A)') '  "all_observed_hpsi_calls_sidecar_consumed": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '  "all_observed_hpsi_calls_sidecar_consumed": false,'
+           ENDIF
+           WRITE(qe_json_unit,'(A)') '  "host_stage_reference_assisted": false,'
+           WRITE(qe_json_unit,'(A)') '  "component_model_reference_replay_only": false,'
+           WRITE(qe_json_unit,'(A)') &
+                '  "l4_execution_proof": {"passed": false, "transport_harness": "python_component_sidecar_not_l4"},'
+        ELSE
+           WRITE(qe_json_unit,'(A)') '  "producer": "qe_hpsi_host_instrumentation_patch",'
+           WRITE(qe_json_unit,'(A)') '  "accelerated_runtime": "pure_software_qe_baseline",'
+           WRITE(qe_json_unit,'(A)') '  "offload_target": "pure_software",'
+           WRITE(qe_json_unit,'(A)') '  "timing_only": true,'
