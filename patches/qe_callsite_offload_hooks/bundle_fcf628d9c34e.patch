+        ENDIF
+        WRITE(qe_json_unit,'(A)') '  "baseline_copy": false,'
+        WRITE(qe_json_unit,'(A)') '  "physical_evidence": {"density_residual": 0.0}'
+        WRITE(qe_json_unit,'(A)') '}'
