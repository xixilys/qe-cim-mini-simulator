+           WRITE(qe_json_unit,'(A)') '    "supported_by_python_sidecar": false,'
+        ENDIF
+        WRITE(qe_json_unit,'(A,I0,A)') '    "nkb": ', nkb, ','
+        WRITE(qe_json_unit,'(A,I0,A)') '    "nhm": ', nhm, ','
+        WRITE(qe_json_unit,'(A,I0,A)') '    "nat": ', nat, ','
+        WRITE(qe_json_unit,'(A,I0,A)') '    "ntyp": ', ntyp, ','
+        WRITE(qe_json_unit,'(A)') '    "nh": ['
+        DO nt = 1, ntyp
+           IF ( nt < ntyp ) THEN
+              WRITE(qe_json_unit,'(A,I0,A)') '      ', nh(nt), ','
+           ELSE
+              WRITE(qe_json_unit,'(A,I0)') '      ', nh(nt)
+           ENDIF
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        WRITE(qe_json_unit,'(A)') '    "ityp": ['
+        DO na = 1, nat
+           IF ( na < nat ) THEN
+              WRITE(qe_json_unit,'(A,I0,A)') '      ', ityp(na), ','
+           ELSE
+              WRITE(qe_json_unit,'(A,I0)') '      ', ityp(na)
+           ENDIF
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        WRITE(qe_json_unit,'(A)') '    "ofsbeta": ['
+        DO na = 1, nat
+           IF ( na < nat ) THEN
+              WRITE(qe_json_unit,'(A,I0,A)') '      ', ofsbeta(na), ','
+           ELSE
+              WRITE(qe_json_unit,'(A,I0)') '      ', ofsbeta(na)
+           ENDIF
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        IF ( .NOT. gamma_only .AND. .NOT. noncolin ) THEN
+        WRITE(qe_json_unit,'(A)') '    "vkb_real_imag": ['
+        qe_entry_index = 0
+        DO jh = 1, nkb
+           DO i = 1, lda
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < lda*nkb ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '      [', DBLE(vkb(i,jh)), ', ', AIMAG(vkb(i,jh)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '      [', DBLE(vkb(i,jh)), ', ', AIMAG(vkb(i,jh)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        WRITE(qe_json_unit,'(A)') '    "deeq_current_spin": ['
+        qe_entry_index = 0
+        DO na = 1, nat
+           DO jh = 1, nhm
+              DO ih = 1, nhm
+                 qe_entry_index = qe_entry_index + 1
+                 IF ( qe_entry_index < nhm*nhm*nat ) THEN
+                    WRITE(qe_json_unit,'(A,ES24.16E3,A)') &
+                         '      ', deeq(ih,jh,na,current_spin), ','
+                 ELSE
+                    WRITE(qe_json_unit,'(A,ES24.16E3)') &
+                         '      ', deeq(ih,jh,na,current_spin)
+                 ENDIF
+              ENDDO
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        WRITE(qe_json_unit,'(A)') '    "becp_k_reference_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, nkb
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < nkb*m ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '      [', DBLE(becp%k(i,ibnd)), ', ', AIMAG(becp%k(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '      [', DBLE(becp%k(i,ibnd)), ', ', AIMAG(becp%k(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '    ],'
+        ELSE
+           WRITE(qe_json_unit,'(A)') '    "vkb_real_imag": [],'
+           WRITE(qe_json_unit,'(A)') '    "deeq_current_spin": [],'
+           WRITE(qe_json_unit,'(A)') '    "becp_k_reference_real_imag": [],'
+        ENDIF
+        WRITE(qe_json_unit,'(A)') '    "claim_boundary": "vnl inputs for sidecar only; no full hpsi recompute"'
+        WRITE(qe_json_unit,'(A)') '  },'
+        WRITE(qe_json_unit,'(A)') '  "g2kin": ['
+        DO i = 1, lda
+           IF ( i < lda ) THEN
+              WRITE(qe_json_unit,'(A,ES24.16E3,A)') '    ', g2kin(i), ','
+           ELSE
+              WRITE(qe_json_unit,'(A,ES24.16E3)') '    ', g2kin(i)
+           ENDIF
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "psi_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, lda*npol
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < qe_total_entries ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(psi(i,ibnd)), ', ', AIMAG(psi(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(psi(i,ibnd)), ', ', AIMAG(psi(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "hpsi_kinetic_reference_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, lda*npol
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < qe_total_entries ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_kinetic(i,ibnd)), ', ', AIMAG(qe_hpsi_kinetic(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_kinetic(i,ibnd)), ', ', AIMAG(qe_hpsi_kinetic(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "hpsi_after_vloc_reference_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, lda*npol
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < qe_total_entries ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_after_vloc(i,ibnd)), ', ', AIMAG(qe_hpsi_after_vloc(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_after_vloc(i,ibnd)), ', ', AIMAG(qe_hpsi_after_vloc(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "hpsi_after_vnl_reference_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, lda*npol
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < qe_total_entries ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_after_vnl(i,ibnd)), ', ', AIMAG(qe_hpsi_after_vnl(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(qe_hpsi_after_vnl(i,ibnd)), ', ', AIMAG(qe_hpsi_after_vnl(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "hpsi_reference_real_imag": ['
+        qe_entry_index = 0
+        DO ibnd = 1, m
+           DO i = 1, lda*npol
+              qe_entry_index = qe_entry_index + 1
+              IF ( qe_entry_index < qe_total_entries ) THEN
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(hpsi(i,ibnd)), ', ', AIMAG(hpsi(i,ibnd)), '],'
+              ELSE
+                 WRITE(qe_json_unit,'(A,ES24.16E3,A,ES24.16E3,A)') &
+                      '    [', DBLE(hpsi(i,ibnd)), ', ', AIMAG(hpsi(i,ibnd)), ']'
+              ENDIF
+           ENDDO
+        ENDDO
+        WRITE(qe_json_unit,'(A)') '  ],'
+        WRITE(qe_json_unit,'(A)') '  "source": "qe_hpsi_host_kernel_boundary_arrays",'
+        WRITE(qe_json_unit,'(A)') '  "claim_boundary": "host reference arrays only; not accelerated output"'
+        WRITE(qe_json_unit,'(A)') '}'
+        CLOSE(qe_json_unit)
+     ENDIF
+     IF ( ALLOCATED(qe_hpsi_kinetic) ) DEALLOCATE(qe_hpsi_kinetic)
+     IF ( ALLOCATED(qe_hpsi_after_vloc) ) DEALLOCATE(qe_hpsi_after_vloc)
+     IF ( ALLOCATED(qe_hpsi_after_vnl) ) DEALLOCATE(qe_hpsi_after_vnl)
+  ENDIF
+  IF ( qe_sidecar_should_attempt ) THEN
+     qe_sidecar_call_count = qe_sidecar_call_count + 1
+     qe_sidecar_exitstat = 1
+     CALL execute_command_line( TRIM(qe_hpsi_sidecar_cmd(1:qe_sidecar_len)), &
+          EXITSTAT=qe_sidecar_exitstat )
+     CALL get_environment_variable( 'QE_OFFLOAD_HPSI_RESULT_TXT', &
+          qe_hpsi_result_path, LENGTH=qe_env_len, STATUS=qe_env_status )
+     IF ( qe_sidecar_exitstat == 0 .AND. qe_env_status == 0 .AND. qe_env_len > 0 ) THEN
+        INQUIRE( FILE=TRIM(qe_hpsi_result_path(1:qe_env_len)), EXIST=qe_sidecar_result_exists )
+        IF ( qe_sidecar_result_exists ) THEN
+           ALLOCATE( qe_hpsi_sidecar(lda*npol,m) )
+           OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_hpsi_result_path(1:qe_env_len)), &
+                STATUS='OLD', ACTION='READ', IOSTAT=qe_io_status )
+           IF ( qe_io_status == 0 ) THEN
+              qe_read_status = 0
+              DO ibnd = 1, m
+                 DO i = 1, lda*npol
+                    READ(qe_json_unit,*,IOSTAT=qe_read_status) qe_sidecar_re, qe_sidecar_im
+                    IF ( qe_read_status /= 0 ) EXIT
+                    qe_hpsi_sidecar(i,ibnd) = CMPLX( qe_sidecar_re, qe_sidecar_im, KIND=DP )
+                 ENDDO
+                 IF ( qe_read_status /= 0 ) EXIT
+              ENDDO
+              CLOSE(qe_json_unit)
+              IF ( qe_read_status == 0 ) THEN
+                 qe_sidecar_abs_error = SQRT( SUM( ABS(qe_hpsi_sidecar(1:lda*npol,1:m) - &
+                      hpsi(1:lda*npol,1:m))**2 ) )
+                 qe_sidecar_ref_l2 = SQRT( SUM( ABS(hpsi(1:lda*npol,1:m))**2 ) )
+                 qe_sidecar_rel_error = qe_sidecar_abs_error / MAX( qe_sidecar_ref_l2, 1.0E-300_DP )
+                 hpsi(1:lda*npol,1:m) = qe_hpsi_sidecar(1:lda*npol,1:m)
+                 qe_sidecar_consumed = .TRUE.
+                 qe_sidecar_consumed_once = .TRUE.
+                 qe_sidecar_success_count = qe_sidecar_success_count + 1
+                 qe_sidecar_abs_error_saved = qe_sidecar_abs_error
+                 qe_sidecar_rel_error_saved = qe_sidecar_rel_error
+                 qe_sidecar_max_abs_error_saved = MAX(qe_sidecar_max_abs_error_saved, qe_sidecar_abs_error)
+                 qe_sidecar_max_rel_error_saved = MAX(qe_sidecar_max_rel_error_saved, qe_sidecar_rel_error)
+              ENDIF
+           ENDIF
+           IF ( ALLOCATED(qe_hpsi_sidecar) ) DEALLOCATE(qe_hpsi_sidecar)
+        ENDIF
+     ENDIF
+     IF ( .NOT. qe_sidecar_consumed ) THEN
+        qe_sidecar_attempt_failed = .TRUE.
+        qe_sidecar_failure_count = qe_sidecar_failure_count + 1
+     ENDIF
+  ENDIF
+  IF ( qe_hpsi_runtime_evidence_enabled .AND. ( qe_sidecar_consumed .OR. qe_sidecar_consumed_once ) ) THEN
+     CALL get_environment_variable( 'QE_OFFLOAD_KERNEL_EVIDENCE_JSON', &
+          qe_kernel_path, LENGTH=qe_env_len, STATUS=qe_env_status )
+     IF ( qe_env_status == 0 .AND. qe_env_len > 0 ) THEN
+        OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_kernel_path(1:qe_env_len)), &
+             STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+        IF ( qe_io_status == 0 ) THEN
+           WRITE(qe_json_unit,'(A)') '['
+           WRITE(qe_json_unit,'(A)') '  {'
+           WRITE(qe_json_unit,'(A)') '    "kernel_id": "h_psi",'
+           WRITE(qe_json_unit,'(A)') '    "kernel_scope": "full_h_psi",'
+           WRITE(qe_json_unit,'(A,I0,A,I0,A,I0,A)') &
+                '    "dimensions": {"lda": ', lda, ', "n": ', n, ', "m": ', m, '},'
+           WRITE(qe_json_unit,'(A)') '    "full_kernel_recomputed": true,'
+           WRITE(qe_json_unit,'(A)') '    "qe_mainflow_integrated": true,'
+           WRITE(qe_json_unit,'(A)') '    "accelerated_results_consumed_by_qe": true,'
+           WRITE(qe_json_unit,'(A)') '    "software_component_model_not_l4": true,'
+           WRITE(qe_json_unit,'(A,I0,A)') '    "sidecar_observed_hpsi_calls": ', qe_hpsi_observed_call_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '    "sidecar_attempted_hpsi_calls": ', qe_sidecar_call_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '    "sidecar_consumed_hpsi_calls": ', qe_sidecar_success_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '    "sidecar_failed_hpsi_calls": ', qe_sidecar_failure_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '    "sidecar_call_cap": ', qe_sidecar_max_calls, ','
+           IF ( qe_sidecar_smoke_only ) THEN
+              WRITE(qe_json_unit,'(A)') '    "single_hpsi_call_smoke_only": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '    "single_hpsi_call_smoke_only": false,'
+           ENDIF
+           IF ( qe_sidecar_success_count == qe_hpsi_observed_call_count .AND. qe_sidecar_failure_count == 0 ) THEN
+              WRITE(qe_json_unit,'(A)') '    "all_observed_hpsi_calls_sidecar_consumed": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '    "all_observed_hpsi_calls_sidecar_consumed": false,'
+           ENDIF
+           WRITE(qe_json_unit,'(A)') '    "host_stage_reference_assisted": false,'
+           WRITE(qe_json_unit,'(A)') '    "component_model_reference_replay_only": false,'
+           WRITE(qe_json_unit,'(A,ES24.16E3,A)') '    "absolute_error": ', qe_sidecar_max_abs_error_saved, ','
+           WRITE(qe_json_unit,'(A,ES24.16E3,A)') '    "relative_error": ', qe_sidecar_max_rel_error_saved, ','
+           WRITE(qe_json_unit,'(A)') '    "source": "python_qe_hpsi_component_model",'
+           WRITE(qe_json_unit,'(A)') '    "timing_only": false,'
+           WRITE(qe_json_unit,'(A)') &
+                '    "claim_boundary": "QE consumed a software component-model sidecar h_psi payload; not trusted L4 offload"'
+           WRITE(qe_json_unit,'(A)') '  }'
+           WRITE(qe_json_unit,'(A)') ']'
+           CLOSE(qe_json_unit)
+        ENDIF
+     ENDIF
+  ENDIF
+  CALL get_environment_variable( 'QE_OFFLOAD_PROVENANCE_JSON', &
+       qe_provenance_path, LENGTH=qe_env_len, STATUS=qe_env_status )
+  IF ( qe_env_status == 0 .AND. qe_env_len > 0 .AND. qe_hpsi_runtime_evidence_enabled ) THEN
+     OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_provenance_path(1:qe_env_len)), &
+          STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+     IF ( qe_io_status == 0 ) THEN
+        WRITE(qe_json_unit,'(A)') '{'
+        IF ( qe_sidecar_consumed .OR. qe_sidecar_consumed_once ) THEN
+           WRITE(qe_json_unit,'(A)') '  "producer": "qe_hpsi_mainflow_component_sidecar_patch",'
+           WRITE(qe_json_unit,'(A)') '  "accelerated_runtime": "qe_offload_runtime",'
+           WRITE(qe_json_unit,'(A)') '  "offload_target": "python_component_sidecar_reference_assisted",'
+           WRITE(qe_json_unit,'(A)') '  "timing_only": false,'
+           WRITE(qe_json_unit,'(A)') '  "pure_software_qe_baseline": false,'
+           WRITE(qe_json_unit,'(A)') '  "full_h_psi_recomputed": true,'
+           WRITE(qe_json_unit,'(A)') '  "qe_mainflow_integrated": true,'
+           WRITE(qe_json_unit,'(A)') '  "accelerated_results_consumed_by_qe": true,'
+           WRITE(qe_json_unit,'(A)') '  "software_component_model_not_l4": true,'
+           WRITE(qe_json_unit,'(A,I0,A)') '  "sidecar_observed_hpsi_calls": ', qe_hpsi_observed_call_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '  "sidecar_attempted_hpsi_calls": ', qe_sidecar_call_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '  "sidecar_consumed_hpsi_calls": ', qe_sidecar_success_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '  "sidecar_failed_hpsi_calls": ', qe_sidecar_failure_count, ','
+           WRITE(qe_json_unit,'(A,I0,A)') '  "sidecar_call_cap": ', qe_sidecar_max_calls, ','
