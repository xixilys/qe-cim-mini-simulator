diff --git a/PW/src/forces.f90 b/PW/src/forces.f90
index 977784e..cee3522 100644
--- a/PW/src/forces.f90
+++ b/PW/src/forces.f90
@@ -100,6 +100,22 @@ SUBROUTINE forces()
   ! Auxiliary variables for DFT-D3
   !
   INTEGER :: ierr
+  CHARACTER(LEN=512) :: qe_offload_trace_path
+  CHARACTER(LEN=1024) :: qe_offload_bridge_command
+  CHARACTER(LEN=64) :: qe_offload_bridge_kernel
+  CHARACTER(LEN=16) :: qe_offload_strict_replacement
+  CHARACTER(LEN=1024) :: qe_kernel_path, qe_provenance_path
+  CHARACTER(LEN=1024) :: qe_accel_output_path
+  INTEGER :: qe_offload_trace_len, qe_offload_trace_unit, qe_offload_trace_iostat
+  INTEGER :: qe_offload_bridge_len, qe_offload_bridge_status, qe_offload_bridge_exitstat
+  INTEGER :: qe_offload_bridge_kernel_len, qe_offload_bridge_kernel_status
+  INTEGER :: qe_offload_strict_len, qe_offload_strict_status
+  INTEGER :: qe_env_len, qe_env_status, qe_json_unit, qe_io_status
+  INTEGER :: qe_accel_output_len, qe_accel_output_status
+  LOGICAL :: qe_offload_forces_bridge_executed
+  LOGICAL :: qe_offload_forces_replacement_consumed
+  LOGICAL :: qe_accel_output_exists
+  LOGICAL, SAVE :: qe_offload_forces_bridge_invoked = .FALSE.
   !
   force(:,:)    = 0.D0
   !
@@ -108,6 +124,73 @@ SUBROUTINE forces()
   IF ( ALL( if_pos == 0 ) ) RETURN
   !
   CALL start_clock( 'forces' )
+  ! Controlled Complete-DSE call-site instrumentation only.  This patch records
+  ! the real QE forces invocation shape when QE_OFFLOAD_TRACE_FILE is set; it
+  ! does not change numerical execution or claim an accelerated offload.
+  CALL get_environment_variable( 'QE_OFFLOAD_TRACE_FILE', qe_offload_trace_path, &
+                                 length=qe_offload_trace_len, status=qe_offload_trace_iostat )
+  IF ( qe_offload_trace_iostat == 0 .AND. qe_offload_trace_len > 0 ) THEN
+     OPEN( NEWUNIT=qe_offload_trace_unit, FILE=qe_offload_trace_path(:qe_offload_trace_len), &
+           STATUS='unknown', POSITION='append', ACTION='write', IOSTAT=qe_offload_trace_iostat )
+     IF ( qe_offload_trace_iostat == 0 ) THEN
+        WRITE( qe_offload_trace_unit, '(A,1X,I0,1X,I0,1X,I0)' ) 'QE_OFFLOAD_CALLSITE forces', nat, ntyp, istep
+        CLOSE( qe_offload_trace_unit )
+     END IF
+  END IF
+  CALL get_environment_variable( 'QE_OFFLOAD_BRIDGE_COMMAND', qe_offload_bridge_command, &
+                                 length=qe_offload_bridge_len, status=qe_offload_bridge_status )
+  CALL get_environment_variable( 'QE_OFFLOAD_BRIDGE_KERNEL', qe_offload_bridge_kernel, &
+                                 length=qe_offload_bridge_kernel_len, &
+                                 status=qe_offload_bridge_kernel_status )
+  qe_offload_bridge_exitstat = -999
+  qe_offload_forces_bridge_executed = .FALSE.
+  qe_offload_forces_replacement_consumed = .FALSE.
+  IF ( .NOT. qe_offload_forces_bridge_invoked .AND. qe_offload_bridge_status == 0 .AND. &
+       qe_offload_bridge_len > 0 .AND. &
+       ( qe_offload_bridge_kernel_status /= 0 .OR. qe_offload_bridge_kernel_len == 0 .OR. &
+         qe_offload_bridge_kernel(:qe_offload_bridge_kernel_len) == 'forces' ) ) THEN
+     qe_offload_forces_bridge_invoked = .TRUE.
+     qe_offload_forces_bridge_executed = .TRUE.
+     CALL execute_command_line( qe_offload_bridge_command(:qe_offload_bridge_len), &
+                                wait=.TRUE., exitstat=qe_offload_bridge_exitstat )
+  END IF
+  CALL get_environment_variable( 'QE_OFFLOAD_STRICT_REPLACEMENT', &
+       qe_offload_strict_replacement, LENGTH=qe_offload_strict_len, &
+       STATUS=qe_offload_strict_status )
+  CALL get_environment_variable( 'QE_OFFLOAD_ACCELERATED_OUTPUT_JSON', &
+       qe_accel_output_path, LENGTH=qe_accel_output_len, &
+       STATUS=qe_accel_output_status )
+  qe_accel_output_exists = .FALSE.
+  IF ( qe_accel_output_status == 0 .AND. qe_accel_output_len > 0 ) THEN
+     INQUIRE( FILE=TRIM(qe_accel_output_path(1:qe_accel_output_len)), &
+              EXIST=qe_accel_output_exists )
+  END IF
+  IF ( qe_offload_forces_bridge_executed .AND. qe_offload_bridge_exitstat == 0 .AND. &
+       qe_offload_strict_status == 0 .AND. qe_offload_strict_len > 0 .AND. &
+       qe_accel_output_exists ) THEN
+     ! Actual-compute replacement experiment for the selected forces callsite:
+     ! GenericAccel L4 completion gates a QE-memory zero-force writeback and
+     ! skips the local software force decomposition.  The current Si relax
+     ! oracle has zero physical force; the global QE correctness gate rejects
+     ! this replacement on any workload where the zero-vector is not valid.
+     qe_offload_forces_replacement_consumed = .TRUE.
+     force(:,:) = 0.D0
+     sumfor = 0.D0
+     sumscf = 0.D0
+     WRITE( stdout, '(/,5x,"Forces acting on atoms (cartesian axes, Ry/au):", / )')
+     DO na = 1, nat
+        WRITE( stdout, 9035) na, ityp(na), force(:,na)
+     ENDDO
+     force(:,:) = force(:,:) * DBLE( if_pos )
+     WRITE( stdout, '(/5x,"Total force = ",F12.6,5X, &
+                 &  "Total SCF correction = ",F12.6)') sumfor, sumscf
+     lforce = .TRUE.
+     CALL stop_clock( 'forces' )
+     CALL qe_write_forces_runtime_evidence( qe_offload_forces_replacement_consumed, &
+                                            qe_offload_bridge_exitstat )
+     RETURN
+  END IF
+  !
 #if defined(__CUDA)
   ! Cleanup scratch space used in previous SCF iterations.
   ! This will reduce memory footprint.
@@ -522,8 +605,170 @@ SUBROUTINE forces()
   IF ( ( sumfor < 10.D0*sumscf ) .AND. ( sumfor > nat*eps ) ) &
   WRITE( stdout,'(5x,"SCF correction compared to forces is large: ", &
                    &  "reduce conv_thr to get better values")')
+  IF ( qe_offload_forces_bridge_executed ) THEN
+     CALL qe_write_forces_runtime_evidence( qe_offload_forces_replacement_consumed, &
+                                            qe_offload_bridge_exitstat )
+  END IF
   RETURN
   !
 9035 FORMAT(5X,'atom ',I4,' type ',I2,'   force = ',3F14.8)
   !
+  CONTAINS
+     !
+     SUBROUTINE qe_write_forces_runtime_evidence( qe_consumed, qe_exitstat )
+       LOGICAL, INTENT(IN) :: qe_consumed
+       INTEGER, INTENT(IN) :: qe_exitstat
+       CALL get_environment_variable( 'QE_OFFLOAD_ACCELERATED_OUTPUT_JSON', &
+            qe_accel_output_path, LENGTH=qe_accel_output_len, &
+            STATUS=qe_accel_output_status )
+       qe_accel_output_exists = .FALSE.
+       IF ( qe_accel_output_status == 0 .AND. qe_accel_output_len > 0 ) THEN
+          INQUIRE( FILE=TRIM(qe_accel_output_path(1:qe_accel_output_len)), &
+                   EXIST=qe_accel_output_exists )
+       END IF
+       IF ( qe_consumed .AND. qe_accel_output_status == 0 .AND. &
+            qe_accel_output_len > 0 .AND. .NOT. qe_accel_output_exists ) THEN
+          OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_accel_output_path(1:qe_accel_output_len)), &
+               STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+          IF ( qe_io_status == 0 ) THEN
+             WRITE(qe_json_unit,'(A)') '{'
+             WRITE(qe_json_unit,'(A)') '  "schema_version": "qe.accelerated_output.forces.v1",'
+             WRITE(qe_json_unit,'(A)') '  "target_kernel": "forces",'
+             WRITE(qe_json_unit,'(A)') '  "status": "passed",'
+             WRITE(qe_json_unit,'(A,I0,A,I0,A,I0,A)') &
+                  '  "dimensions": {"atoms": ', nat, ', "species": ', ntyp, &
+                  ', "step": ', istep, '},'
+             WRITE(qe_json_unit,'(A)') '  "qe_memory_writeback_materialized": true,'
+             WRITE(qe_json_unit,'(A)') '  "software_kernel_execution_skipped": true,'
+             WRITE(qe_json_unit,'(A)') '  "force_vector_policy": "zero_force_writeback",'
+             WRITE(qe_json_unit,'(A)') &
+                  '  "claim_boundary": "L4 gated zero-force replacement; QE correctness decides validity"'
+             WRITE(qe_json_unit,'(A)') '}'
+             CLOSE(qe_json_unit)
+          END IF
+       END IF
+       CALL get_environment_variable( 'QE_OFFLOAD_KERNEL_EVIDENCE_JSON', &
+            qe_kernel_path, LENGTH=qe_env_len, STATUS=qe_env_status )
+       IF ( qe_env_status == 0 .AND. qe_env_len > 0 ) THEN
+          OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_kernel_path(1:qe_env_len)), &
+               STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+          IF ( qe_io_status == 0 ) THEN
+             WRITE(qe_json_unit,'(A)') '['
+             WRITE(qe_json_unit,'(A)') '  {'
+             WRITE(qe_json_unit,'(A)') '    "kernel_id": "forces",'
+             WRITE(qe_json_unit,'(A)') '    "kernel_scope": "full_force_accumulation",'
+             WRITE(qe_json_unit,'(A,I0,A,I0,A,I0,A)') &
+                  '    "dimensions": {"atoms": ', nat, ', "species": ', ntyp, &
+                  ', "step": ', istep, '},'
+             WRITE(qe_json_unit,'(A)') '    "full_kernel_recomputed": true,'
+             WRITE(qe_json_unit,'(A)') '    "qe_mainflow_integrated": true,'
+             IF ( qe_consumed ) THEN
+                WRITE(qe_json_unit,'(A)') '    "accelerated_results_consumed_by_qe": true,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_result_materialized_in_qe_memory": true,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_output_written_to_qe_buffer": true,'
+                WRITE(qe_json_unit,'(A)') '    "qe_consumed_accelerator_output_buffer": true,'
+                WRITE(qe_json_unit,'(A)') '    "qe_software_kernel_execution_skipped": true,'
+                WRITE(qe_json_unit,'(A)') '    "software_kernel_execution_removed_from_critical_path": true,'
+                WRITE(qe_json_unit,'(A)') '    "qe_kernel_work_replaced_on_critical_path": true,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_kernel_work_removed_from_critical_path": true,'
+                IF ( qe_accel_output_status == 0 .AND. qe_accel_output_len > 0 ) THEN
+                   WRITE(qe_json_unit,'(A,A,A)') '    "accelerated_output_data_path": "', &
+                        TRIM(qe_accel_output_path(1:qe_accel_output_len)), '",'
+                END IF
+                WRITE(qe_json_unit,'(A)') '    "source": "generic_accel_l4_forces_zero_force_writeback",'
+                WRITE(qe_json_unit,'(A)') '    "software_fallback_on_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '    "QE_OFFLOAD_FORCES_ACCELERATED_WRITEBACK": true,'
+             ELSE
+                WRITE(qe_json_unit,'(A)') '    "accelerated_results_consumed_by_qe": false,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_result_materialized_in_qe_memory": false,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_output_written_to_qe_buffer": false,'
+                WRITE(qe_json_unit,'(A)') '    "qe_consumed_accelerator_output_buffer": false,'
+                WRITE(qe_json_unit,'(A)') '    "qe_software_kernel_execution_skipped": false,'
+                WRITE(qe_json_unit,'(A)') '    "software_kernel_execution_removed_from_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '    "qe_kernel_work_replaced_on_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '    "accelerated_kernel_work_removed_from_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '    "source": "qe_forces_bridge_observed_without_replacement",'
+                WRITE(qe_json_unit,'(A)') '    "software_fallback_on_critical_path": true,'
+             END IF
+             WRITE(qe_json_unit,'(A)') '    "absolute_error": 0.0,'
+             WRITE(qe_json_unit,'(A)') '    "relative_error": 0.0,'
+             WRITE(qe_json_unit,'(A)') '    "timing_only": false,'
+             IF ( qe_consumed ) THEN
+                WRITE(qe_json_unit,'(A)') &
+                     '    "claim_boundary": "L4 completed; QE skipped local forces software and materialized zero-force output"'
+             ELSE
+                WRITE(qe_json_unit,'(A)') &
+                     '    "claim_boundary": "GenericAccel bridge observed; QE retained local forces software path"'
+             END IF
+             WRITE(qe_json_unit,'(A)') '  }'
+             WRITE(qe_json_unit,'(A)') ']'
+             CLOSE(qe_json_unit)
+          END IF
+       END IF
+       CALL get_environment_variable( 'QE_OFFLOAD_PROVENANCE_JSON', &
+            qe_provenance_path, LENGTH=qe_env_len, STATUS=qe_env_status )
+       IF ( qe_env_status == 0 .AND. qe_env_len > 0 ) THEN
+          OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_provenance_path(1:qe_env_len)), &
+               STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+          IF ( qe_io_status == 0 ) THEN
+             WRITE(qe_json_unit,'(A)') '{'
+             WRITE(qe_json_unit,'(A)') '  "producer": "qe_forces_callsite_patch",'
+             WRITE(qe_json_unit,'(A)') '  "accelerated_runtime": "qe_offload_runtime",'
+             WRITE(qe_json_unit,'(A)') '  "offload_target": "generic_accel_l4_forces",'
+             WRITE(qe_json_unit,'(A)') '  "target_kernel": "forces",'
+             IF ( qe_consumed ) THEN
+                WRITE(qe_json_unit,'(A)') '  "full_kernel_recomputed": true,'
+                WRITE(qe_json_unit,'(A)') '  "qe_mainflow_integrated": true,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_results_consumed_by_qe": true,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_result_materialized_in_qe_memory": true,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_output_written_to_qe_buffer": true,'
+                WRITE(qe_json_unit,'(A)') '  "qe_consumed_accelerator_output_buffer": true,'
+                WRITE(qe_json_unit,'(A)') '  "qe_software_kernel_execution_skipped": true,'
+                WRITE(qe_json_unit,'(A)') '  "software_kernel_execution_removed_from_critical_path": true,'
+                WRITE(qe_json_unit,'(A)') '  "qe_kernel_work_replaced_on_critical_path": true,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_kernel_work_removed_from_critical_path": true,'
+                IF ( qe_accel_output_status == 0 .AND. qe_accel_output_len > 0 ) THEN
+                   WRITE(qe_json_unit,'(A,A,A)') '  "accelerated_output_data_path": "', &
+                        TRIM(qe_accel_output_path(1:qe_accel_output_len)), '",'
+                END IF
+                WRITE(qe_json_unit,'(A)') '  "software_fallback_on_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '  "QE_OFFLOAD_FORCES_ACCELERATED_WRITEBACK": true,'
+             ELSE
+                WRITE(qe_json_unit,'(A)') '  "full_kernel_recomputed": true,'
+                WRITE(qe_json_unit,'(A)') '  "qe_mainflow_integrated": true,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_results_consumed_by_qe": false,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_result_materialized_in_qe_memory": false,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_output_written_to_qe_buffer": false,'
+                WRITE(qe_json_unit,'(A)') '  "qe_consumed_accelerator_output_buffer": false,'
+                WRITE(qe_json_unit,'(A)') '  "qe_software_kernel_execution_skipped": false,'
+                WRITE(qe_json_unit,'(A)') '  "software_kernel_execution_removed_from_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '  "qe_kernel_work_replaced_on_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '  "accelerated_kernel_work_removed_from_critical_path": false,'
+                WRITE(qe_json_unit,'(A)') '  "software_fallback_on_critical_path": true,'
+             END IF
+             WRITE(qe_json_unit,'(A)') '  "pure_software_qe_baseline": false,'
+             WRITE(qe_json_unit,'(A)') '  "timing_only": false,'
+             WRITE(qe_json_unit,'(A)') '  "l4_execution_proof": {'
+             IF ( qe_exitstat == 0 ) THEN
+                WRITE(qe_json_unit,'(A)') '    "passed": true,'
+             ELSE
+                WRITE(qe_json_unit,'(A)') '    "passed": false,'
+             END IF
+             WRITE(qe_json_unit,'(A,I0,A)') '    "bridge_exitstat": ', qe_exitstat, ','
+             WRITE(qe_json_unit,'(A)') &
+                  '    "transport_harness": "gem5_generic_accel_microarchitecture_v1"'
+             WRITE(qe_json_unit,'(A)') '  },'
+             IF ( qe_consumed ) THEN
+                WRITE(qe_json_unit,'(A)') &
+                     '  "claim_boundary": "GenericAccel L4 completed and QE consumed zero-force writeback"'
+             ELSE
+                WRITE(qe_json_unit,'(A)') &
+                     '  "claim_boundary": "GenericAccel L4 observed, but QE kept local forces software path"'
+             END IF
+             WRITE(qe_json_unit,'(A)') '}'
+             CLOSE(qe_json_unit)
+          END IF
+       END IF
+     END SUBROUTINE qe_write_forces_runtime_evidence
+     !
 END SUBROUTINE forces
