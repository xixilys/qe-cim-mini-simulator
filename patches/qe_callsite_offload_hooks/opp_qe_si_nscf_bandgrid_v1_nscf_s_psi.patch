+  CHARACTER(LEN=64) :: qe_spsi_bridge_kernel
+  INTEGER :: qe_spsi_trace_len, qe_spsi_trace_unit, qe_spsi_trace_iostat
+  INTEGER :: qe_spsi_bridge_len, qe_spsi_bridge_status, qe_spsi_bridge_exitstat
+  INTEGER :: qe_spsi_bridge_kernel_len, qe_spsi_bridge_kernel_status
