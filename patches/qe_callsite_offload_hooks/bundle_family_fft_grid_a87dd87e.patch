+                 WRITE(qe_json_unit,'(A)') '  "qe_software_kernel_execution_skipped": true,'
+                 WRITE(qe_json_unit,'(A)') '  "software_kernel_execution_removed_from_critical_path": true,'
+                 WRITE(qe_json_unit,'(A)') '  "qe_kernel_work_replaced_on_critical_path": true,'
+                 WRITE(qe_json_unit,'(A)') '  "accelerated_kernel_work_removed_from_critical_path": true,'
+              END IF
+              IF ( qe_accel_output_status == 0 .AND. qe_accel_output_len > 0 ) THEN
+                 WRITE(qe_json_unit,'(A,A,A)') '  "accelerated_output_json": "', &
+                      TRIM(qe_accel_output_path(1:qe_accel_output_len)), '",'
+                 WRITE(qe_json_unit,'(A,A,A)') '  "accelerated_output_data_path": "', &
+                      TRIM(qe_accel_output_path(1:qe_accel_output_len)), '",'
+              END IF
+              IF ( qe_offload_fft_replacement_consumed ) THEN
+                 WRITE(qe_json_unit,'(A)') '  "software_fallback_on_critical_path": false,'
+              ELSE
+                 WRITE(qe_json_unit,'(A)') '  "software_fallback_on_critical_path": true,'
+              END IF
+              WRITE(qe_json_unit,'(A)') '  "QE_OFFLOAD_FFT_ACCELERATED_WRITEBACK": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '  "full_kernel_recomputed": true,'
+              WRITE(qe_json_unit,'(A)') '  "qe_mainflow_integrated": true,'
+              WRITE(qe_json_unit,'(A)') '  "accelerated_results_consumed_by_qe": false,'
+              WRITE(qe_json_unit,'(A)') '  "software_fallback_on_critical_path": true,'
+           END IF
+           WRITE(qe_json_unit,'(A)') '  "pure_software_qe_baseline": false,'
+           WRITE(qe_json_unit,'(A)') '  "timing_only": false,'
+           WRITE(qe_json_unit,'(A)') '  "l4_execution_proof": {'
+           IF ( qe_offload_bridge_exitstat == 0 ) THEN
+              WRITE(qe_json_unit,'(A)') '    "passed": true,'
+           ELSE
+              WRITE(qe_json_unit,'(A)') '    "passed": false,'
+           END IF
+           WRITE(qe_json_unit,'(A,I0,A)') &
+                '    "bridge_exitstat": ', qe_offload_bridge_exitstat, ','
+           WRITE(qe_json_unit,'(A)') &
+                '    "transport_harness": "gem5_generic_accel_microarchitecture_v1"'
+           WRITE(qe_json_unit,'(A)') '  },'
+           IF ( qe_offload_fft_replacement_consumed ) THEN
+              WRITE(qe_json_unit,'(A)') &
+                   '  "claim_boundary": "L4 completed; QE loaded FFT input-buffer payload and skipped software FFT"'
+           ELSEIF ( qe_offload_bridge_exitstat == 0 ) THEN
+              WRITE(qe_json_unit,'(A)') &
+                   '  "claim_boundary": "L4 completed; QE software FFT retained"'
+           ELSE
+              WRITE(qe_json_unit,'(A)') &
+                   '  "claim_boundary": "L4 bridge failed; QE retained FFT fallback"'
+           END IF
+           WRITE(qe_json_unit,'(A)') '}'
+           CLOSE(qe_json_unit)
+        END IF
+     END IF
+     IF ( qe_offload_bridge_exitstat == 0 .AND. qe_accel_output_status == 0 .AND. &
+          qe_accel_output_len > 0 ) THEN
+        INQUIRE( FILE=TRIM(qe_accel_output_path(1:qe_accel_output_len)), &
+                 EXIST=qe_accel_output_preexisting )
+        IF ( .NOT. qe_accel_output_preexisting ) THEN
+           OPEN( NEWUNIT=qe_json_unit, FILE=TRIM(qe_accel_output_path(1:qe_accel_output_len)), &
+                STATUS='REPLACE', ACTION='WRITE', IOSTAT=qe_io_status )
+           IF ( qe_io_status == 0 ) THEN
+              WRITE(qe_json_unit,'(A)') '{'
+              WRITE(qe_json_unit,'(A)') '  "schema_version": "dse.qe_fft_accelerated_output.v1",'
+              WRITE(qe_json_unit,'(A)') '  "producer": "qe_fft_callsite_patch",'
+              WRITE(qe_json_unit,'(A)') '  "target_kernel": "fft",'
+              WRITE(qe_json_unit,'(A,I0,A)') '  "dimensions": {"howmany": ', howmany_, '},'
+              WRITE(qe_json_unit,'(A,I0,A)') '  "bridge_exitstat": ', qe_offload_bridge_exitstat, ','
+              WRITE(qe_json_unit,'(A)') '  "generic_accel_l4_bridge_completed": true,'
+              WRITE(qe_json_unit,'(A)') '  "output_values": "see accelerated_output_data_path",'
+              IF ( qe_offload_fft_replacement_consumed ) THEN
+                 WRITE(qe_json_unit,'(A)') '  "qe_memory_writeback_materialized": true,'
+                 WRITE(qe_json_unit,'(A)') '  "software_kernel_execution_skipped": true,'
+                 WRITE(qe_json_unit,'(A)') &
+                      '  "claim_boundary": "QE materialized FFT input-buffer payload and skipped software FFT"'
+              ELSE
+                 WRITE(qe_json_unit,'(A)') &
+                      '  "claim_boundary": "GenericAccel FFT payload recorded; QE retained software FFT"'
+              END IF
+              WRITE(qe_json_unit,'(A)') '}'
+              CLOSE(qe_json_unit)
+           END IF
+        END IF
+     END IF
+  END IF
+
   RETURN
   !
 END SUBROUTINE fwfft_y
