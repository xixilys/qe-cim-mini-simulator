Import('*')

SimObject('FPGAAccelerator.py', sim_objects=['FPGAAccelerator'])

if env['CONF']['USE_SYSTEMC']:
    env.Append(CPPDEFINES=['USE_SYSTEMC'])
    # SystemC model integration note:
    # To use the real DFT model instead of stub:
    # 1. Rebuild libgem5_systemc_bridge.a for host architecture
    # 2. Add LIBPATH and LIBS for the model library
    # 3. Uncomment SystemC model includes in fpga_accelerator.cc

Source('fpga_accelerator.cc')

SimObject('FPGAAcceleratorSE.py', sim_objects=['FPGAAcceleratorSE'])
Source('fpga_accelerator_se.cc')

# SystemC stub for gem5 integration
if env['CONF']['USE_SYSTEMC']:
    Source('sc_main_stub.cc')

DebugFlag('FPGAAccelerator', 'FPGA Accelerator device operations')
DebugFlag('FPGAAccel', 'FPGA Accelerator SE device operations')
DebugFlag('FPGADMA', 'FPGA DMA engine operations')
DebugFlag('FPGATLM', 'FPGA TLM transactions')
