# Makefile for QE-SystemC Integration
#
# Builds C wrapper, Fortran interface, and test program

# Paths
SYSTEMC_MODEL_DIR = ../systemc_model
SYSTEMC_MODEL_BUILD = $(SYSTEMC_MODEL_DIR)/build
SYSTEMC_HOME = /opt/homebrew/Cellar/systemc/3.0.2
MAIN_MODEL_DIR = ../../model/qe_band_solver_model

# Compilers
CXX = g++
FC = gfortran
CC = gcc

# Flags
CXXFLAGS = -std=c++17 -O2 -Wall -I$(SYSTEMC_MODEL_DIR)/include -I$(MAIN_MODEL_DIR)/include -I$(SYSTEMC_HOME)/include -DQE_BAND_SOLVER_USE_SYSTEMC
FCFLAGS = -O2 -Wall -fcheck=all
GFORTRAN_LIB = $(shell gfortran -print-file-name=libgfortran.dylib | xargs dirname)
LDFLAGS = -L$(GFORTRAN_LIB)
LIBS = -lgfortran -lstdc++

# Targets
.PHONY: all clean test

all: test_fpga_interface

# C wrapper object (mock version - no SystemC dependencies)
fpga_systemc_wrapper.o: fpga_systemc_wrapper_mock.cpp fpga_systemc_wrapper.h
	$(CXX) -std=c++17 -O2 -Wall -c $< -o $@

# Fortran interface module
fpga_systemc_interface.o: fpga_systemc_interface.f90
	$(FC) $(FCFLAGS) -c $< -o $@

# Test program
test_fpga_interface.o: test_fpga_interface.f90 fpga_systemc_interface.o
	$(FC) $(FCFLAGS) -c $< -o $@

# Link test program (use g++ to avoid libstdc++/libc++ conflict)
test_fpga_interface: test_fpga_interface.o fpga_systemc_interface.o fpga_systemc_wrapper.o
	$(CXX) $^ -o $@ $(LDFLAGS) $(LIBS)

# Run test
test: test_fpga_interface
	@echo "========================================="
	@echo "Running SystemC FPGA Interface Test"
	@echo "========================================="
	./test_fpga_interface

# Clean
clean:
	rm -f *.o *.mod test_fpga_interface

# Help
help:
	@echo "Available targets:"
	@echo "  all   - Build test program (default)"
	@echo "  test  - Build and run test program"
	@echo "  clean - Remove build artifacts"
	@echo "  help  - Show this help message"
