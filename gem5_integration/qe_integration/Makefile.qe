# Makefile for QE FPGA offload test
#
# This builds a standalone test that demonstrates how QE electrons()
# would call the FPGA accelerator

# Compiler settings
FC = gfortran
CC = gcc
CXX = g++

# Compiler flags
FFLAGS = -O2 -Wall -fcheck=all
CFLAGS = -std=c11 -O2 -Wall
CXXFLAGS = -std=c++17 -O2 -Wall

# Linker flags
LDFLAGS = -lstdc++

# Detect gfortran library path
GFORTRAN_LIB := $(shell gfortran -print-file-name=libgfortran.so 2>/dev/null || \
                        gfortran -print-file-name=libgfortran.dylib 2>/dev/null || \
                        echo "")

ifneq ($(GFORTRAN_LIB),)
  GFORTRAN_LIBDIR := $(dir $(GFORTRAN_LIB))
  LDFLAGS += -L$(GFORTRAN_LIBDIR) -lgfortran
else
  LDFLAGS += -lgfortran
endif

# Source files
FSRC = fpga_systemc_interface_qe.f90 test_qe_fpga_offload.f90
CSRC = fpga_systemc_wrapper_mock.cpp

# Object files
FOBJ = $(FSRC:.f90=.o)
COBJ = $(CSRC:.cpp=.o)

# Target executable
TARGET = test_qe_fpga_offload

# Default target
all: $(TARGET)

# Build executable
$(TARGET): $(FOBJ) $(COBJ)
	@echo "Linking $@..."
	$(FC) $(FOBJ) $(COBJ) -o $@ -lstdc++
	@echo "Build complete: $@"

# Compile Fortran sources
%.o: %.f90
	@echo "Compiling $<..."
	$(FC) $(FFLAGS) -c $< -o $@

# Compile C++ sources
%.o: %.cpp
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Module dependencies
test_qe_fpga_offload.o: fpga_systemc_interface_qe.o

# Run test
test: $(TARGET)
	@echo ""
	@echo "Running test..."
	@echo ""
	./$(TARGET)

# Clean
clean:
	rm -f $(FOBJ) $(COBJ) *.mod $(TARGET)
	@echo "Clean complete"

# Help
help:
	@echo "Available targets:"
	@echo "  all    - Build test program (default)"
	@echo "  test   - Build and run test"
	@echo "  clean  - Remove build artifacts"
	@echo "  help   - Show this help message"

.PHONY: all test clean help
