# Makefile for FPGA offload performance benchmark
#
# This builds a comprehensive benchmark suite that tests multiple
# QE workloads and measures CPU vs FPGA performance

# Compiler settings
FC = gfortran
CC = gcc
CXX = g++

# Compiler flags
FFLAGS = -O2 -Wall -fcheck=all
CFLAGS = -std=c11 -O2 -Wall
CXXFLAGS = -std=c++17 -O2 -Wall

# Linker flags
LDFLAGS = -lstdc++

# Detect gfortran library path
GFORTRAN_LIB := $(shell gfortran -print-file-name=libgfortran.so 2>/dev/null || \
                        gfortran -print-file-name=libgfortran.dylib 2>/dev/null || \
                        echo "")

ifneq ($(GFORTRAN_LIB),)
  GFORTRAN_LIBDIR := $(dir $(GFORTRAN_LIB))
  LDFLAGS += -L$(GFORTRAN_LIBDIR) -lgfortran
else
  LDFLAGS += -lgfortran
endif

# Source files
FSRC = fpga_systemc_interface_qe.f90 benchmark_fpga_offload.f90
CSRC = fpga_systemc_wrapper_mock.cpp

# Object files
FOBJ = $(FSRC:.f90=.o)
COBJ = $(CSRC:.cpp=.o)

# Target executable
TARGET = benchmark_fpga_offload

# Default target
all: $(TARGET)

# Build executable
$(TARGET): $(FOBJ) $(COBJ)
	@echo "Linking $@..."
	$(FC) $(FOBJ) $(COBJ) -o $@ -lstdc++
	@echo "Build complete: $@"

# Compile Fortran sources
%.o: %.f90
	@echo "Compiling $<..."
	$(FC) $(FFLAGS) -c $< -o $@

# Compile C++ sources
%.o: %.cpp
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Module dependencies
benchmark_fpga_offload.o: fpga_systemc_interface_qe.o

# Run benchmark
run: $(TARGET)
	@echo ""
	@echo "Running benchmark suite..."
	@echo ""
	./$(TARGET)

# Run and save results
benchmark: $(TARGET)
	@echo ""
	@echo "Running benchmark suite and saving results..."
	@echo ""
	./$(TARGET) | tee benchmark_results_$(shell date +%Y%m%d_%H%M%S).txt

# Clean
clean:
	rm -f $(FOBJ) $(COBJ) *.mod $(TARGET)
	@echo "Clean complete"

# Help
help:
	@echo "Available targets:"
	@echo "  all       - Build benchmark program (default)"
	@echo "  run       - Build and run benchmark"
	@echo "  benchmark - Build, run, and save results with timestamp"
	@echo "  clean     - Remove build artifacts"
	@echo "  help      - Show this help message"

.PHONY: all run benchmark clean help
