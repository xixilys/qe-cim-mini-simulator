# Dockerfile for gem5 FPGA test program cross-compilation
# Uses musl-cross for static x86_64 Linux binaries

FROM alpine:latest

# Install build dependencies including musl cross-compiler
RUN apk add --no-cache \
    build-base \
    musl-dev \
    linux-headers \
    git \
    wget \
    tar \
    musl-utils

# Install x86_64-linux-musl cross-compiler from musl.cc
RUN wget https://musl.cc/x86_64-linux-musl-cross.tgz && \
    tar -xzf x86_64-linux-musl-cross.tgz -C /usr/local && \
    rm x86_64-linux-musl-cross.tgz

# Set up environment
ENV PATH="/usr/local/x86_64-linux-musl-cross/bin:${PATH}"
ENV CC="x86_64-linux-musl-gcc"
ENV CXX="x86_64-linux-musl-g++"

WORKDIR /workspace

# Default command
CMD ["x86_64-linux-musl-gcc", "--version"]
